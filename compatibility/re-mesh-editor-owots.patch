+"""Blender --background --factory-startup --python this.py -- <original.mdf2.51> <output-dir>."""
+import importlib
+import json
+from pathlib import Path
+import sys
+
+import addon_utils
+import bpy
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+addon_utils.enable('RE-Mesh-Editor-main', default_set=False)
+m = importlib.import_module('RE-Mesh-Editor-main.modules.mdf.blender_re_mdf')
+source, output = map(Path, sys.argv[sys.argv.index('--') + 1:])
+output.mkdir(parents=True, exist_ok=True)
+original = m.readMDF(str(source))
+assert original.isOnimushaVariant
+assert m.importMDFFile(str(source))
+c = next(c for c in bpy.data.collections if c.get('~TYPE') == 'RE_MDF_COLLECTION')
+objects = sorted(c.all_objects, key=lambda o: o.name)
+expected = {x.materialName: x.ver51UnknValue for x in original.materialList}
+
+def verify(label):
+    built = m.buildMDF(c.name, 51)
+    path = output / (label + '.mdf2.51')
+    m.writeMDF(built, str(path))
+    actual = m.readMDF(str(path))
+    assert actual.Header.materialFlags == original.Header.materialFlags
+    assert {x.materialName: x.ver51UnknValue for x in actual.materialList} == expected
+    fast = importlib.import_module('RE-Mesh-Editor-main.modules.mdf.file_re_mdf').readMDFFast(str(path))
+    assert [len(x.textureList) for x in fast.materialList] == [len(x.textureList) for x in actual.materialList]
+    print('PASS', label)
+
+verify('fresh_import')
+# Fresh imports retain metadata without access to original files, and use collection identity.
+c['re_mdf_source_path'] = 'missing.mdf2.51'
+c['re_export_baseline'] = '{}'
+bpy.context.scene.re_mdf_toolpanel.activeGame = 'RE9'
+verify('source_unavailable')
+# Legacy scenes recover only opaque fields; authored paths are kept.
+del c['re_mdf_header_flags']
+del c['re_mdf_onimusha_variant']
+del c['re_mdf_source_path']
+for obj in objects:
+    del obj['re_mdf_owots_value']
+c['re_export_baseline'] = json.dumps({'source': str(source)})
+binding = objects[0].re_mdf_material.textureBindingList_items[0]
+binding.path = 'custom/edited.tex'
+verify('legacy_scene')
+assert m.buildMDF(c.name, 51).materialList[0].textureList[0].texturePath == 'custom/edited.tex'
+c['re_export_baseline'] = '{}'
+try:
+    m.buildMDF(c.name, 51)
+except ValueError as error:
+    assert 'Reimport' in str(error)
+else:
+    raise AssertionError('Missing OWOTS metadata must not silently export zeros')
+print('PASS missing_source_guard')
