+"""Small UI adapters for the shared workspace exporter."""
+import json
+import tempfile
+import uuid
+from pathlib import Path
+
+import bpy
+from bpy.props import BoolProperty, CollectionProperty, EnumProperty, StringProperty
+from bpy_extras.io_utils import ImportHelper
+
+from .export_pipeline import execute_export, plan_export
+from .export_tracking import BASELINE, IDENTITY, identity
+from .export_manifest import safe_relative
+from ... import translations
+
+
+def outliner_selection(context):
+    """Read selection in the Outliner's WINDOW region, even from the sidebar."""
+    selected = {}
+    for area in context.screen.areas if context.screen else []:
+        if area.type != "OUTLINER":
+            continue
+        region = next((r for r in area.regions if r.type == "WINDOW"), None)
+        if region is None:
+            continue
+        with context.temp_override(area=area, region=region):
+            for item in getattr(context, "selected_ids", ()):
+                if isinstance(item, bpy.types.Collection):
+                    selected[item.as_pointer()] = item
+    return list(selected.values())
+
+
+def selected_asset_collections(context):
+    """Expand only selected collection trees; resolve MDF separately by identity."""
+    scene_collections = {c.as_pointer() for c in context.scene.collection.children_recursive}
+    result = {}
+    for selected in outliner_selection(context):
+        for collection in (selected, *selected.children_recursive):
+            if (collection.as_pointer() in scene_collections
+                    and collection.get("~TYPE") == "RE_MESH_COLLECTION"):
+                result[collection.as_pointer()] = collection
+    return list(result.values())
+
+
+class REExportCollectionEntry(bpy.types.PropertyGroup):
+    collection_name: StringProperty()
+    enabled: BoolProperty(name="Export", default=False)
+
+    @property
+    def collection(self):
+        return bpy.data.collections.get(self.collection_name)
+
+    @collection.setter
+    def collection(self, value):
+        self.collection_name = value.name
+
+
+class ExportWorkspaceMixin:
+    bl_options = {"REGISTER"}
+    entries: CollectionProperty(type=REExportCollectionEntry)
+    analyze_changes: BoolProperty(name="Check Changes", default=False, options={"SKIP_SAVE"},
+        description="Run a full change check now; export always checks once before writing")
+    force_mesh: BoolProperty(name="Force Export All Selected Meshes", default=False,
+        description="Skip mesh baseline comparison, including failed import mesh validation; current meshes must still pass export validation")
+    force_mdf: BoolProperty(name="Force Export Associated MDF", default=False,
+        description="Always export associated MDF; recover missing links only from a unique sibling MDF with the same game path")
+    prefer_baseline_textures: BoolProperty(name="Prefer Baseline Texture Paths", default=False,
+        description="Write edited images to their original imported texture paths, including streaming/base pairs; MDF bindings remain unchanged")
+    image_source: EnumProperty(name="Conflicting Image Source", items=[
+        ("ERROR", "Report Conflict", "Require a choice if Blender pixels and the external file both changed"),
+        ("MEMORY", "Blender Pixels", "Use the edited image in Blender"),
+        ("DISK", "External File", "Use the edited file on disk")])
+    accept_alpha: BoolProperty(name="Accept Constant Alpha", description="Allow JPEG inputs to supply an opaque alpha channel", default=False)
+    additional_source: StringProperty(name="Additional Asset", subtype="FILE_PATH")
+    additional_path: StringProperty(name="Game Asset Path", description="Full relative game path, starting with natives/")
+
+    @classmethod
+    def poll(cls, context):
+        return context.scene.get("modWorkspace_setup", False) and context.mode == "OBJECT"
+
+    def _build(self, context):
+        additional = []
+        if self.additional_source or self.additional_path:
+            additional.append((bpy.path.abspath(self.additional_source), self.additional_path))
+        # Freeze the selection at invoke: opening a dialog must not change scope.
+        collections = ([e.collection for e in self.entries if e.collection]
+                       if self.entries else selected_asset_collections(context))
+        if not collections and not additional:
+            raise ValueError(bpy.app.translations.pgettext_iface("Select a model collection in the Outliner"))
+        return plan_export(context, collections,
+                           self.image_source, self.accept_alpha, additional, force_mesh=self.force_mesh, force_mdf=self.force_mdf,
+                           prefer_baseline_textures=self.prefer_baseline_textures)
+
+    def invoke(self, context, event):
+        self.entries.clear()
+        for collection in selected_asset_collections(context):
+            entry = self.entries.add()
+            entry.collection = collection
+            entry.enabled = True
+        self._summary = {}
+        self._errors = []
+        self._checked_options = None
+        return context.window_manager.invoke_props_dialog(self, width=620)
+
+    def _refresh(self, context):
+        try:
+            plan = self._build(context)
+            try:
+                self._summary = {kind: sum(a["kind"] == kind for a in plan.assets.values()) for kind in ("MESH", "MDF", "TEX", "FILE")}
+                self._errors = plan.errors
+            finally:
+                plan.close()
+        except Exception as error:
+            self._summary = {}
+            self._errors = [str(error)]
+
+    def check(self, context):
+        options = (self.force_mesh, self.force_mdf, self.prefer_baseline_textures, self.image_source, self.accept_alpha,
+                   self.additional_source, self.additional_path)
+        if self.analyze_changes:
+            self.analyze_changes = False
+            self._refresh(context)
+            self._checked_options = options
+            return True
+        if options != getattr(self, "_checked_options", None):
+            self._summary = {}
+            self._errors = []
+            self._checked_options = options
+            return True
+        return False
+
+    def draw(self, context):
+        layout = self.layout
+        layout.label(text="Detected Selected Assets")
+        layout.label(text="Associated MDF and textures are included automatically")
+        box = layout.box()
+        for entry in self.entries:
+            if not entry.collection:
+                continue
+            row = box.row(align=True)
+            row.label(text=entry.collection.name, icon="OUTLINER_COLLECTION")
+            op = row.operator("re_mod_workspace.rebuild_export_baseline", text="", icon="FILE_REFRESH")
+            op.collection_name = entry.collection.name
+        layout.operator("re_mesh.batch_exporter", text="Mesh Export Settings", icon="PREFERENCES")
+        layout.prop(self, "force_mesh")
+        layout.prop(self, "force_mdf")
+        layout.prop(self, "prefer_baseline_textures")
+        if self.prefer_baseline_textures:
+            layout.label(text="MDF bindings remain unchanged", icon="INFO")
+        layout.prop(self, "image_source")
+        layout.prop(self, "accept_alpha")
+        layout.prop(self, "additional_source")
+        if self.additional_source:
+            layout.prop(self, "additional_path")
+        layout.prop(self, "analyze_changes", toggle=True, icon="VIEWZOOM")
+        if not getattr(self, "_summary", {}):
+            layout.label(text="Changes will be checked when you confirm export")
+        for kind, count in getattr(self, "_summary", {}).items():
+            layout.label(text=f"{kind}: {count}")
+        for error in getattr(self, "_errors", [])[:8]:
+            layout.label(text=error, icon="ERROR")
+
+    def execute(self, context):
+        plan = None
+        try:
+            plan = self._build(context)
+            result = execute_export(context, plan, make_pak=self.bl_idname.endswith("export_mod_pak"))
+            self.report({"INFO"}, translations.tipf("Exported {changed} changed assets; Mod contains {total} assets. {path}", **result))
+            return {"FINISHED"}
+        except Exception as error:
+            self.report({"ERROR"}, str(error))
+            return {"CANCELLED"}
+        finally:
+            if plan:
+                plan.close()
+
+
+class WM_OT_ExportModWorkspace(ExportWorkspaceMixin, bpy.types.Operator):
+    bl_idname = "re_mod_workspace.export_mod_workspace"
+    bl_label = "Export Mod Workspace"
+    bl_description = "Export changed meshes, MDF and textures belonging to selected Outliner collections"
+
+
+class WM_OT_ExportModPak(ExportWorkspaceMixin, bpy.types.Operator):
+    bl_idname = "re_mod_workspace.export_mod_pak"
+    bl_label = "Export Mod PAK"
+    bl_description = "Update selected Outliner assets and package all current Mod assets"
+
+
+class WM_OT_RebuildExportBaseline(bpy.types.Operator, ImportHelper):
+    bl_idname = "re_mod_workspace.rebuild_export_baseline"
+    bl_label = "Bind Original Source"
+    bl_description = "Reimport an original game file in an isolated scene to recover tracking without resetting your edits"
+    collection_name: StringProperty()
+    filter_glob: StringProperty(default="*.mesh.*;*.mdf2.*", options={"HIDDEN"})
+    target_path: StringProperty(name="Game Asset Path", description="Optional target path starting with natives/, including the numeric version")
+
+    def draw(self, context):
+        self.layout.prop(self, "target_path")
+
+    def execute(self, context):
+        from .export_tracking import capture_materials
+        target = bpy.data.collections.get(self.collection_name)
+        if not target:
+            self.report({"ERROR"}, "Select a collection to bind")
+            return {"CANCELLED"}
+        old_scene = context.window.scene
+        old_game = old_scene.re_mdf_toolpanel.activeGame
+        kinds = ("objects", "collections", "meshes", "armatures", "materials", "images", "node_groups")
+        before = {k: {item.as_pointer() for item in getattr(bpy.data, k)} for k in kinds}
+        isolated = bpy.data.scenes.new("RE baseline recovery")
+        prefs = context.preferences.addons[__package__.split(".")[0]].preferences
+        old_cache, old_console = prefs.textureCachePath, prefs.showConsole
+        cache = tempfile.TemporaryDirectory(prefix="re-baseline-")
+        group_names = [(g, g.name) for g in bpy.data.node_groups]
+        try:
+            prefs.textureCachePath = cache.name
+            prefs.showConsole = False
+            for group, name in group_names:
+                group.name = "RE_RECOVERY_" + uuid.uuid4().hex
+            context.window.scene = isolated
+            if target.get("~TYPE") == "RE_MESH_COLLECTION":
+                result = bpy.ops.re_mesh.importfile(filepath=self.filepath, directory=str(Path(self.filepath).parent), files=[{"name": Path(self.filepath).name}], clearScene=False, loadMaterials=True,
+                    loadMDFData=True, createCollections=True, reloadCachedTextures=True)
+            else:
+                result = bpy.ops.re_mdf.importfile(filepath=self.filepath, directory=str(Path(self.filepath).parent), files=[{"name": Path(self.filepath).name}])
+            if "FINISHED" not in result:
+                raise ValueError("Original file import failed")
+            imported = [c for c in isolated.collection.children_recursive if c.get("~TYPE") == target.get("~TYPE")]
+            if len(imported) != 1:
+                raise ValueError("Original source did not produce one matching asset collection")
+            source = imported[0]
+            baseline = json.loads(source[BASELINE])
+            if self.target_path:
+                relative = safe_relative(self.target_path)
+                if not relative.lower().startswith("natives/") or not relative.endswith("." + str(baseline["version"])):
+                    raise ValueError("Target must start with natives/ and retain the source version")
+                baseline["relative"] = relative
+            if baseline.get("error"):
+                raise ValueError(baseline["error"])
+            # Use current identifiers on the original material graph, so real graph differences remain detectable.
+            if target.get("~TYPE") == "RE_MESH_COLLECTION":
+                parents = [c for c in bpy.data.collections if target.name in c.children]
+                associated = [c for p in parents for c in p.children if c.get("~TYPE") == "RE_MDF_COLLECTION" and c.as_pointer() in before["collections"]]
+                original_mdf = next((c for c in isolated.collection.children_recursive if c.get(IDENTITY) == baseline.get("mdf")), None)
+                if len(associated) != 1 or original_mdf is None:
+                    raise ValueError("Place the original mesh and its MDF under one asset parent before recovery")
+                current_mdf = associated[0]
+                original_mdf[IDENTITY] = identity(current_mdf)
+                current_materials = {s.material for o in target.all_objects if o.type == "MESH" for s in o.material_slots if s.material}
+                def map_nodes(original_tree, current_tree, seen=None):
+                    seen = set() if seen is None else seen
+                    if original_tree.as_pointer() in seen:
+                        return
+                    seen.add(original_tree.as_pointer())
+                    for node in original_tree.nodes:
+                        current_node = current_tree.nodes.get(node.name)
+                        if current_node:
+                            node[IDENTITY] = identity(current_node)
+                            if node.type == "GROUP" and current_node.type == "GROUP" and node.node_tree and current_node.node_tree:
+                                map_nodes(node.node_tree, current_node.node_tree, seen)
+                for original in [s.material for o in source.all_objects if o.type == "MESH" for s in o.material_slots if s.material]:
+                    matching = [m for m in current_materials if m.name.split(".")[0] == original.name.split(".")[0]]
+                    if len(matching) != 1:
+                        raise ValueError("Cannot uniquely match legacy material; restore original material names")
+                    current = matching[0]
+                    original[IDENTITY] = identity(current)
+                    map_nodes(original.node_tree, current.node_tree)
+                for original in original_mdf.all_objects:
+                    matches = [o for o in current_mdf.all_objects if o.get("~TYPE") == "RE_MDF_MATERIAL" and o.re_mdf_material.materialName == original.re_mdf_material.materialName]
+                    if len(matches) == 1:
+                        original[IDENTITY] = identity(matches[0])
+                baseline["mdf"] = identity(current_mdf)
+                baseline["materials"] = capture_materials(source, original_mdf)
+                for material_entry in baseline["materials"]:
+                    for slot in material_entry["slots"]:
+                        state = slot.get("state")
+                        if state and state["path"]:
+                            path = Path(state["path"])
+                            if path.is_relative_to(cache.name):
+                                state["path"] = str(Path(bpy.path.abspath(old_cache)) / path.relative_to(cache.name))
+                current_mdf[BASELINE] = original_mdf[BASELINE]
+            target[BASELINE] = json.dumps(baseline)
+            identity(target)
+            self.report({"INFO"}, "Original baseline recovered; reopen Export Mod Workspace")
+            return {"FINISHED"}
+        except Exception as error:
+            self.report({"ERROR"}, str(error))
+            return {"CANCELLED"}
+        finally:
+            prefs.textureCachePath, prefs.showConsole = old_cache, old_console
+            context.window.scene = old_scene
+            old_scene.re_mdf_toolpanel.activeGame = old_game
+            bpy.data.scenes.remove(isolated)
+            for kind in kinds:
+                data = getattr(bpy.data, kind)
+                for item in list(data):
+                    if item.as_pointer() not in before[kind]:
+                        data.remove(item, do_unlink=True)
+            for group, name in group_names:
+                group.name = name
+            cache.cleanup()
+
+
+CLASSES = (REExportCollectionEntry, WM_OT_RebuildExportBaseline, WM_OT_ExportModWorkspace, WM_OT_ExportModPak)
