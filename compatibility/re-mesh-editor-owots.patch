@@ -0,0 +1,51 @@
+"""Blender --python this_file -- --blend <saved test blend> --output <test workspace>."""
+import argparse,sys,importlib,json
+from pathlib import Path
+import bpy,addon_utils
+parser=argparse.ArgumentParser()
+parser.add_argument('--blend',required=True)
+parser.add_argument('--output',required=True)
+args=parser.parse_args(sys.argv[sys.argv.index('--')+1:])
+sys.path.insert(0,str(Path(__file__).resolve().parents[2]))
+addon_utils.enable('RE-Mesh-Editor-main',default_set=True)
+bpy.context.preferences.addons['RE-Mesh-Editor-main'].preferences.showConsole=False
+bpy.ops.wm.open_mainfile(filepath=args.blend)
+p=importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_pipeline')
+t=importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_tracking')
+collections=[c for c in bpy.context.scene.collection.children_recursive if c.get('~TYPE')=='RE_MESH_COLLECTION']
+before={c.name:c[t.BASELINE] for c in collections}
+normal=p.plan_export(bpy.context,collections)
+assert any('baseline' in e for e in normal.errors),normal.errors
+normal.close()
+forced=p.plan_export(bpy.context,collections,force_mesh=True)
+assert not forced.errors,forced.errors
+assert sum(a['kind']=='MESH' for a in forced.assets.values())==len(collections)
+assert all(a['kind']=='MESH' for a in forced.assets.values()),forced.assets.keys()
+bpy.context.scene['modWorkspace_directory']=str(Path(args.output).resolve())
+result=p.execute_export(bpy.context,forced)
+forced.close()
+reader=importlib.import_module('RE-Mesh-Editor-main.modules.mesh.file_re_mesh').readREMesh
+files=list(Path(args.output).rglob('*.mesh.260209350'))
+assert len(files)==len(collections)
+for path in files: assert reader(str(path)) is not None
+# Force must include an unchanged mesh, but never expand to unselected meshes.
+body=next(c for c in collections if '00_00.mesh' in c.name)
+baseline=json.loads(body[t.BASELINE])
+baseline['fingerprint']=t.snapshot(body,baseline['game'],baseline['version'])[0]
+body[t.BASELINE]=json.dumps(baseline)
+normal=p.plan_export(bpy.context,[body]);assert not normal.errors and not normal.assets;normal.close()
+forced=p.plan_export(bpy.context,[body],force_mesh=True)
+assert not forced.errors and sum(a['kind']=='MESH' for a in forced.assets.values())==1
+forced.close()
+body[t.BASELINE]=before[body.name]
+assert {c.name:c[t.BASELINE] for c in collections}==before
+# Current mesh validation is never bypassed.
+original=p.snapshot
+try:
+ def invalid(*args,**kwargs):raise ValueError('CURRENT_MESH_INVALID')
+ p.snapshot=invalid
+ plan=p.plan_export(bpy.context,[body],force_mesh=True)
+ assert any('CURRENT_MESH_INVALID' in e for e in plan.errors)
+ plan.close()
+finally:p.snapshot=original
+print('FORCE_MESH_PASS',result,flush=True)
