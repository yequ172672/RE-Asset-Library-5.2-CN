+u=importlib.import_module('RE-Mesh-Editor-main.modules.tex.re_tex_utils')
+with tempfile.TemporaryDirectory(prefix='re-game-color-') as tmp:
+ root=Path(tmp)
+ for fmt in ('BC7UNORM','BC7UNORMSRGB'):
+  outputs=[]
+  for cs in ('sRGB','Non-Color'):
+   img=bpy.data.images.new('Authored data',width=16,height=16,alpha=True)
+   img.colorspace_settings.name=cs
+   values=np.tile(np.array([.2,.4,.6,.3],dtype=np.float32),256)
+   img.pixels.foreach_set(values);img.update()
+   before=t.pixel_hash(img)
+   meta={'format':fmt,'version':251111100,'count':1,'cube':0}
+   for variant in ('dirty','packed','resized','file','dds'):
+    if variant=='packed':img.pack()
+    target=root/(fmt+cs.replace('-','')+variant+'.tex.251111100')
+    source=img
+    if variant=='file':
+     tx.save_pixels(img,root/'input.png')
+     source=bpy.data.images.load(str(root/'input.png'),check_existing=False)
+     source.colorspace_settings.name=cs
+    if variant=='dds':
+     source=bpy.data.images.load(str(root/'decoded.dds'),check_existing=False)
+     source.colorspace_settings.name=cs
+    tx.convert_image(source,target,meta,'OWOTS',size=(8,8) if variant=='resized' else None)
+    u.convertTexFileToDDS(str(target),str(root/'decoded.dds'))
+    decoded=bpy.data.images.load(str(root/'decoded.dds'),check_existing=False)
+    actual=np.array(decoded.pixels[:4]);assert np.max(np.abs(actual-[.2,.4,.6,.3]))<.035,(fmt,cs,variant,actual)
+    outputs.append((variant,target.read_bytes()))
+    assert img.colorspace_settings.name==cs and t.pixel_hash(img)==before
+  for a,b in zip(outputs[:5],outputs[5:]):assert a==b,(fmt,a[0])
+print('GAME_COLORSPACE_PASS',flush=True)
+# Exercise the real operator with multiple selected MDF objects.
+for o in bpy.context.selected_objects:o.select_set(False)
+objects=[]
+for i in range(2):
+ o=bpy.data.objects.new('MDF test '+str(i),None);bpy.context.scene.collection.objects.link(o)
+ o['~TYPE']='RE_MDF_MATERIAL';o.re_mdf_material.gameName='OWOTS'
+ o.re_mdf_material.materialName=o.name
+ for kind in ('BaseMap','BaseBlend_NRMR','Unknown_Test_Binding'):
+  e=o.re_mdf_material.textureBindingList_items.add();e.textureType=kind;e.path='original.tex'
+ o.select_set(True);objects.append(o)
+bpy.context.view_layer.objects.active=objects[1]
+assert bpy.ops.re_mdf.nullify_texture_bindings()=={'FINISHED'}
+for o in objects:
+ entries=o.re_mdf_material.textureBindingList_items
+ assert entries[0].path=='systems/rendering/NullWhite.tex'
+ assert entries[1].path=='systems/rendering/NullNormalRoughness.tex'
+ assert entries[2].path=='original.tex'
+assert bpy.ops.re_mdf.nullify_texture_bindings()=={'FINISHED'}
+for o in objects:o.select_set(False)
+assert bpy.ops.re_mdf.nullify_texture_bindings()=={'CANCELLED'}
