+"""Blender 5.2: --python this_file -- --output EXISTING_ACCEPTANCE_DIRECTORY."""
+import argparse
+import importlib
+import sys
+from pathlib import Path
+import bpy
+import addon_utils
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--output", required=True)
+args = parser.parse_args(sys.argv[sys.argv.index("--") + 1:])
+base = Path(args.output).resolve()
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+addon_utils.enable("RE-Mesh-Editor-main", default_set=True)
+t = importlib.import_module("RE-Mesh-Editor-main.modules.workspace.export_tracking")
+tx = importlib.import_module("RE-Mesh-Editor-main.modules.workspace.export_textures")
+
+source = base / "external-state.png"
+first = bpy.data.images.new("external original", width=8, height=8, alpha=True)
+first.generated_color = (.1, .2, .3, 1)
+first.file_format = "PNG"
+first.filepath_raw = str(source)
+first.save()
+original = bpy.data.images.load(str(source), check_existing=False)
+state = t.image_state(original)
+second = bpy.data.images.new("external edited", width=8, height=8, alpha=True)
+second.generated_color = (.7, .6, .5, 1)
+second.file_format = "PNG"
+second.filepath_raw = str(source)
+second.save()
+resolved, temporary = tx.resolve_image(original, state)
+assert temporary and t.pixel_hash(resolved) != state["pixels"]
+bpy.data.images.remove(resolved)
+original.pixels[0] = .9
+original.update()
+try:
+    tx.resolve_image(original, state)
+except ValueError as error:
+    assert "both" in str(error)
+else:
+    raise AssertionError("Concurrent disk and Blender edits were not rejected")
+assert tx.resolve_image(original, state, "MEMORY")[0] == original
+resolved, temporary = tx.resolve_image(original, state, "DISK")
+assert temporary and resolved != original
+bpy.data.images.remove(resolved)
+print("EXTERNAL_IMAGE_CONFLICT_PASS", flush=True)
+
+bpy.ops.wm.open_mainfile(filepath=str(base / "acceptance.blend"))
+mesh = next(c for c in bpy.data.collections if c.get("~TYPE") == "RE_MESH_COLLECTION")
+baseline = t.load_baseline(mesh)
