@@ -0,0 +1,88 @@
+"""Blender regression for selected asset collection scope."""
+import importlib
+import json
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+import bpy
+import addon_utils
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+addon_utils.enable('RE-Mesh-Editor-main', default_set=True)
+ui = importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_operators')
+tracking = importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_tracking')
+scene = bpy.context.scene
+scene['modWorkspace_setup'] = True
+
+def collection(name, parent, kind=None):
+    item = bpy.data.collections.new(name)
+    parent.children.link(item)
+    if kind:
+        item['~TYPE'] = kind
+    return item
+parents, roots, mdfs = [], [], []
+for i in range(3):
+    parent = collection('Imported asset '+str(i), scene.collection)
+    mesh = collection('Model '+str(i), parent, 'RE_MESH_COLLECTION')
+    mdf = collection('Materials '+str(i), parent, 'RE_MDF_COLLECTION')
+    mesh[tracking.BASELINE] = json.dumps({'mdf': tracking.identity(mdf)})
+    parents.append(parent)
+    roots.append(mesh)
+    mdfs.append(mdf)
+nested = collection('Nested folder', parents[0])
+nested.children.link(roots[0])
+other = bpy.data.scenes.new('Other scene')
+other_mesh = collection('Other model', other.collection, 'RE_MESH_COLLECTION')
+original_selection, original_plan, original_execute = ui.outliner_selection, ui.plan_export, ui.execute_export
+try:
+    selected = []
+    ui.outliner_selection = lambda context: selected
+    assert ui.selected_asset_collections(bpy.context) == []
+    selected[:] = [parents[0], roots[0], roots[2], other_mesh]
+    assert set(ui.selected_asset_collections(bpy.context)) == {roots[0], roots[2]}
+    assert set(tracking.expand_collections(ui.selected_asset_collections(bpy.context))) == {roots[0], roots[2], mdfs[0], mdfs[2]}
+    class Entries(list):
+        def add(self):
+            entry = SimpleNamespace()
+            self.append(entry)
+            return entry
+    entries = Entries()
+    op = SimpleNamespace(entries=entries, _refresh=lambda context: None)
+    context = SimpleNamespace(scene=scene, window_manager=SimpleNamespace(invoke_props_dialog=lambda *args, **kwargs: {'RUNNING_MODAL'}))
+    assert ui.ExportWorkspaceMixin.invoke(op, context, None) == {'RUNNING_MODAL'}
+    assert {e.collection for e in entries} == {roots[0], roots[2]}
+    class Plan:
+        def close(self):
+            pass
+    def plan(context, collections, *args, **kwargs):
+        assert set(collections) == {roots[0], roots[2]}, collections
+        return Plan()
+    ui.plan_export = plan
+    ui.execute_export = lambda *args, **kwargs: {'changed': 0, 'total': 0, 'path': ''}
+    assert bpy.ops.re_mod_workspace.export_mod_workspace() == {'FINISHED'}
+    assert bpy.ops.re_mod_workspace.export_mod_pak() == {'FINISHED'}
+    # Dialog freezes the initial model selection, even if Outliner focus changes.
+    selected.clear()
+    op.image_source, op.accept_alpha = 'ERROR', False
+    op.force_mesh = False
+    op.force_mdf = False
+    op.additional_source, op.additional_path = '', ''
+    ui.ExportWorkspaceMixin._build(op, bpy.context).close()
+    assert ui.selected_asset_collections(bpy.context) == []
+finally:
+    ui.outliner_selection, ui.plan_export, ui.execute_export = original_selection, original_plan, original_execute
+# Verify sidebar reads override the Outliner region as well as its area.
+region = SimpleNamespace(type='WINDOW')
+area = SimpleNamespace(type='OUTLINER', regions=[region])
+class Override:
+    def __enter__(self):
+        return self
+    def __exit__(self, *args):
+        pass
+class Context:
+    screen = SimpleNamespace(areas=[area])
+    selected_ids = [parents[0]]
+    def temp_override(self, **kwargs):
+        assert kwargs == {'area': area, 'region': region}
+        return Override()
+assert ui.outliner_selection(Context()) == [parents[0]]
+print('SELECTED_ASSET_DISCOVERY_PASS', flush=True)
