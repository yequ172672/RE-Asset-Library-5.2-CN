+assert b.data==mesh and len(b.data.vertices)==3
+assert a['keep']=='value' and tuple(a.location)==(1,2,3) and a.data.materials[0]==mat
+assert bpy.context.view_layer.objects.active==a and a.select_get() and not b.select_get()
+assert 'UNDO' in importlib.import_module('RE-Mesh-Editor-main.modules.mesh.re_mesh_operators').WM_OT_ConvertToEmptyMesh.bl_options
+bpy.ops.object.select_all(action='DESELECT');assert not bpy.ops.re_mesh.convert_to_empty_mesh.poll()
