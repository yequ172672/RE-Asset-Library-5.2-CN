diff --git a/modules/workspace/texture_worker.py b/modules/workspace/texture_worker.py
new file mode 100644
index 0000000..ef6a76b
--- /dev/null
+++ b/modules/workspace/texture_worker.py
@@ -0,0 +1,23 @@
+"""One-shot native DDS encoding, isolated from Blender's process and callbacks."""
+import ctypes
+import json
+import os
+from pathlib import Path
+import sys
+
+
+def main(request_path):
+    sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+    from ddsconv.directx.texconv import Texconv
+    request = json.loads(Path(request_path).read_text(encoding="utf-8"))
+    if os.name == "nt":
+        ctypes.windll.ole32.CoInitializeEx(None, 0)
+    # Do not explicitly unload: native codec/GPU worker state can outlive the
+    # exported call. Process teardown releases it without touching Blender.
+    path = Texconv().convert_to_dds(request["source"], request["format"],
+        out=request["output"], no_mip=False, verbose=False, ignore_source_colorspace=True, regenerate_mips=True)
+    Path(request["result"]).write_text(json.dumps({"dds": path}), encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main(sys.argv[1])
