+"""Convert Blender images to native TEX without writing intermediate files beside sources."""
+from pathlib import Path
+import os
+import tempfile
+import json
+import subprocess
+import sys
+
+import bpy
+import numpy as np
+
+from .export_tracking import image_path, pixel_hash, tex_metadata
+from .export_manifest import file_hash
+
+INPUT_EXTENSIONS = {".png", ".jpg", ".jpeg", ".tga", ".tif", ".tiff", ".dds"}
+
+
+def encode_dds(source, dds_format, temporary):
+    """A native codec failure must never terminate Blender or publish outputs."""
+    version = ".".join(str(v) for v in bpy.app.version[:2])
+    executable = "python.exe" if os.name == "nt" else "python3"
+    candidates = [Path(sys.prefix) / "bin" / executable,
+                  Path(bpy.app.binary_path).parent / version / "python" / "bin" / executable]
+    python = next((p for p in candidates if p.is_file()), None)
+    if python is None:
+        raise ValueError("Blender's bundled Python could not be found for isolated texture conversion")
+    request_path, result_path = temporary / "encode.json", temporary / "result.json"
+    request_path.write_text(json.dumps(dict(source=str(source), format=dds_format,
+        output=str(temporary), result=str(result_path))), encoding="utf-8")
+    try:
+        result = subprocess.run([str(python), str(Path(__file__).with_name("texture_worker.py")), str(request_path)],
+            capture_output=True, timeout=300,
+            creationflags=subprocess.CREATE_NO_WINDOW if os.name == "nt" else 0)
+    except subprocess.TimeoutExpired as error:
+        raise ValueError(f"Texture encoder timed out: {source}") from error
+    if result.returncode or not result_path.is_file():
+        detail = (result.stderr or result.stdout).decode("utf-8", errors="replace")[-1600:]
+        raise ValueError(f"Texture encoder failed for {source} (exit {result.returncode}): {detail}")
+    dds = Path(json.loads(result_path.read_text(encoding="utf-8"))["dds"])
+    if not dds.is_file() or not dds.resolve().is_relative_to(temporary.resolve()):
+        raise ValueError(f"Texture encoder returned an invalid output: {source}")
+    return str(dds)
+
+
+def resolve_image(image, original, conflict="ERROR", current_pixels=None):
+    """Return an image and whether it is temporary; disk edits are loaded separately."""
+    path = image_path(image)
+    current_disk = file_hash(path) if path and Path(path).is_file() else None
+    same_path = path == original.get("path")
+    external = same_path and current_disk is not None and current_disk != original.get("disk")
+    memory = (current_pixels or pixel_hash(image)) != original.get("pixels")
+    if external and memory and conflict == "ERROR":
+        raise ValueError(f"Image changed both in Blender and on disk; choose image source: {image.name}")
+    if external and (not memory or conflict == "DISK"):
+        loaded = bpy.data.images.load(path, check_existing=False)
+        loaded.colorspace_settings.name = image.colorspace_settings.name
+        loaded.alpha_mode = "CHANNEL_PACKED"
+        return loaded, True
+    return image, False
+
+
+def save_pixels(image, path, size=None):
+    values = np.empty(len(image.pixels), dtype=np.float32)
+    image.pixels.foreach_get(values)
+    copy = bpy.data.images.new("RE export temporary image", width=image.size[0], height=image.size[1], alpha=True, float_buffer=False)
+    try:
+        # Treat channel values as authored game data. Never re-tag the original
+        # image: Blender may reload it and discard unsaved pixel edits.
+        copy.colorspace_settings.name = "Non-Color"
+        copy.alpha_mode = "CHANNEL_PACKED"
+        copy.pixels.foreach_set(values)
+        copy.update()
+        if size and tuple(copy.size) != tuple(size):
+            copy.scale(*size)
+        copy.file_format = "PNG"
+        copy.filepath_raw = str(path)
+        copy.save()
+    finally:
+        bpy.data.images.remove(copy)
+
+
+def convert_image(image, target, metadata, game, accept_alpha=False, size=None, force_pixels=False):
+    from ..tex.re_tex_utils import DDSToTex
+    from ..tex.enums.dxgi_format_enum import formatStringToDXGIDict
+    from ..ddsconv.directx.dxgi_format import DXGI_FORMAT
+    width, height = size or tuple(image.size)
+    if width < 1 or height < 1 or width > 16384 or height > 16384:
+        raise ValueError(f"Invalid texture dimensions: {image.name} ({width} x {height})")
+    if metadata.get("count", 1) != 1 or metadata.get("cube", 0):
+        raise ValueError(f"Texture arrays/cubemaps require a complete texture set: {image.name}")
+    fmt = metadata["format"]
+    if "BC6" in fmt or "FLOAT" in fmt:
+        raise ValueError(f"HDR texture conversion is not supported by this image workflow: {fmt}")
+    path = image_path(image)
+    if path and Path(path).suffix.lower() not in INPUT_EXTENSIONS and image.source == "FILE":
+        raise ValueError(f"Unsupported image format: {path}")
+    if Path(path).suffix.lower() in {".jpg", ".jpeg"} and not accept_alpha and ("BC7" in fmt or "BC3" in fmt or "A" in fmt):
+        raise ValueError(f"JPEG has no alpha; enable Accept Constant Alpha or supply an RGBA image: {image.name}")
+    target = Path(target)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix=".texture-", dir=target.parent) as temp:
+        temp = Path(temp)
+        # Clean file inputs preserve their original precision and encoded channels.
+        clean = path and Path(path).is_file() and not image.is_dirty and not image.packed_file and not size and not force_pixels
+        # Texconv can retain an existing compressed DDS's truncated mip chain,
+        # even with -m 0. Rebuild from decoded channels to create all levels.
+        if Path(path).suffix.lower() == ".dds" and fmt.startswith("BC"):
+            clean = False
+        source = Path(path) if clean else temp / "pixels.png"
+        if not clean:
+            save_pixels(image, source, size)
+        dds_format = DXGI_FORMAT(formatStringToDXGIDict[fmt]).name
+        dds = encode_dds(source, dds_format, temp)
+        DDSToTex([dds], metadata["version"], str(target), compressOverride=False if game == "OWOTS" else None)
+    actual = tex_metadata(str(target))
+    if (actual["width"], actual["height"]) != (width, height) or actual["version"] != metadata["version"] or actual["format"] != fmt:
+        raise ValueError(f"Converted TEX metadata mismatch: {target.name}")
+    expected_mips = max(width, height).bit_length()
+    if actual["mips"] != expected_mips:
+        raise ValueError(f"Converted TEX mip chain mismatch: {target.name} ({actual['mips']} / {expected_mips})")
diff --git a/modules/workspace/export_tracking.py b/modules/workspace/export_tracking.py
new file mode 100644
index 0000000..206e79f
--- /dev/null
+++ b/modules/workspace/export_tracking.py
@@ -0,0 +1,301 @@
+"""Persistent import baselines and snapshots built by the real game exporters."""
+from contextlib import contextmanager
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import uuid
+from types import SimpleNamespace
+
+import bpy
+import numpy as np
+
+from .export_manifest import file_hash, safe_relative
+
+BASELINE = "re_export_baseline"
+IDENTITY = "re_export_id"
+SOURCE_TEX = "re_export_tex_source"
+SUPPORTED = {"RE_MESH_COLLECTION", "RE_MDF_COLLECTION"}
+OPTION_DEFAULTS = dict(exportAllLODs=False, exportBlendShapes=False, rotate90=True,
+                       useBlenderMaterialName=False, preserveBoneMatrices=True,
+                       exportBoundingBoxes=False, autoSolveRepeatedUVs=True, preserveSharpEdges=True)
+
+
+def identity(data):
+    if not data.get(IDENTITY):
+        data[IDENTITY] = uuid.uuid4().hex
+    return data[IDENTITY]
+
+
+def image_path(image):
+    return os.path.abspath(bpy.path.abspath(image.filepath_raw, library=image.library)) if image.filepath_raw else ""
+
+
+def pixel_hash(image):
+    values = np.empty(len(image.pixels), dtype=np.float32)
+    image.pixels.foreach_get(values)
+    digest = hashlib.sha256()
+    digest.update(str(tuple(image.size)).encode())
+    digest.update(values.astype("<f4", copy=False).tobytes())
+    return digest.hexdigest()
+
+
+def image_state(image):
+    path = image_path(image)
+    return dict(pixels=pixel_hash(image), path=path,
+                disk=file_hash(path) if os.path.isfile(path) else None,
+                colorspace=image.colorspace_settings.name)
+
+
+def asset_relative(path):
+    parts = str(path).replace("\\", "/").split("/")
+    indices = [i for i, part in enumerate(parts) if part.lower() == "natives"]
+    if not indices or len(parts) < indices[-1] + 3:
+        raise ValueError(f"Source must have a natives/platform path: {path}")
+    return safe_relative("/".join(parts[indices[-1]:]))
+
+
+def mesh_options(collection):
+    addon = bpy.context.preferences.addons.get(__package__.split(".")[0])
+    prefs = addon.preferences if addon else None
+    result = {}
+    for key, default in OPTION_DEFAULTS.items():
+        result[key] = bool(collection.get("BatchExport_" + key, getattr(prefs, "default_" + key, default)))
+    result.update(targetCollection=collection.name, selectedOnly=False)
+    return result
+
+
+@contextmanager
+def export_context(game):
+    scene = bpy.context.scene
+    panel = scene.re_mdf_toolpanel
+    old_game = panel.activeGame
+    selected = list(bpy.context.selected_objects)
+    active = bpy.context.view_layer.objects.active
+    tracked = {k: scene.get(k) for k in ("REMeshLastExportedMeshVersion", "REMeshLastExportedCollection")}
+    kinds = ("objects", "collections", "meshes", "armatures")
+    existing = {kind: {d.as_pointer() for d in getattr(bpy.data, kind)} for kind in kinds}
+    try:
+        if bpy.context.mode != "OBJECT":
+            raise ValueError("Switch to Object Mode before exporting")
+        if bpy.data.collections.get("clonedMeshes"):
+            raise ValueError("A collection named clonedMeshes occupies the exporter's temporary collection name")
+        panel.activeGame = game
+        yield
+    finally:
+        for kind in kinds:
+            data = getattr(bpy.data, kind)
+            for item in list(data):
+                if item.as_pointer() not in existing[kind]:
+                    data.remove(item, do_unlink=True)
+        panel.activeGame = old_game
+        for obj in bpy.context.selected_objects:
+            obj.select_set(False)
+        for obj in selected:
+            if obj.name in bpy.context.view_layer.objects:
+                obj.select_set(True)
+        if active and active.name in bpy.context.view_layer.objects:
+            bpy.context.view_layer.objects.active = active
+        for key, value in tracked.items():
+            if value is None:
+                if key in scene:
+                    del scene[key]
+            else:
+                scene[key] = value
+
+
+def snapshot(collection, game, version, details=None):
+    """Serialize the same constructed data used by manual export, into memory."""
+    stream = io.BytesIO()
+    with export_context(game):
+        if collection.get("~TYPE") == "RE_MESH_COLLECTION":
+            from ..mesh.blender_re_mesh import exportREMeshFile
+            from ..mesh.file_re_mesh import meshFileVersionToNewVersionDict
+            options = mesh_options(collection)
+            options["_returnExportData"] = True
+            data = exportREMeshFile(f"snapshot.mesh.{version}", options)
+            if not data:
+                raise ValueError(f"Mesh validation failed: {collection.name}")
+            data.meshVersion = version
+            if details is not None:
+                details["material_names"] = [data.rawNameList[i] for i in data.materialNameRemapList]
+            data.write(stream, meshFileVersionToNewVersionDict[version])
+        else:
+            from ..mdf.blender_re_mdf import buildMDF
+            data = buildMDF(collection.name, version)
+            if data is None:
+                raise ValueError(f"MDF validation failed: {collection.name}")
+            if details is not None:
+                details["material_names"] = [m.materialName for m in data.materialList]
+            data.write(stream, version)
+    payload = stream.getvalue()
+    return hashlib.sha256(payload).hexdigest(), payload
+
+
+def graph_state(material, aliases=None, ignored=(), _seen=None, input_overrides=None, track_outputs=False, output_overrides=None):
+    """Ignore layout/names; retain export-relevant links, defaults and node settings."""
+    if not material.use_nodes:
+        return "no-nodes"
+    seen = set() if _seen is None else set(_seen)
+    pointer = material.node_tree.as_pointer()
+    if pointer in seen:
+        return "recursive-node-group"
+    seen.add(pointer)
+    aliases = aliases or {}
+    nodes = [n for n in material.node_tree.nodes if n.get(IDENTITY) not in ignored]
+    node_id = lambda n: aliases.get(identity(n), identity(n))
+    values = []
+    for node in nodes:
+        identity(node)
+        inputs = []
+        for socket in node.inputs:
+            value = getattr(socket, "default_value", None)
+            if value is not None and not isinstance(value, (str, bool, int, float)):
+                try:
+                    value = list(value)
+                except TypeError:
+                    value = str(type(value))
+            inputs.append(value)
+        inputs = (input_overrides or {}).get(node_id(node), inputs)
+        settings = [(k, getattr(node, k)) for k in ("operation", "blend_type", "interpolation", "extension", "projection", "uv_map", "vector_type") if hasattr(node, k)]
+        if hasattr(node, "color_ramp"):
+            settings.append(("color_ramp", (node.color_ramp.interpolation, [(e.position, list(e.color)) for e in node.color_ramp.elements])))
+        if track_outputs and node.type in {"VALUE", "RGB"}:
+            settings.append(("output_defaults", (output_overrides or {}).get(node_id(node), parameter_node_state(node)["outputs"])))
+        if node.type == "GROUP" and node.node_tree:
+            settings.append(("group", graph_state(SimpleNamespace(use_nodes=True, node_tree=node.node_tree), _seen=seen, track_outputs=track_outputs)))
+        values.append((node_id(node), node.bl_idname, node.mute, inputs, settings))
+    links = sorted((node_id(link.from_node), link.from_socket.identifier,
+                    node_id(link.to_node), link.to_socket.identifier) for link in material.node_tree.links
+                   if link.from_node.get(IDENTITY) not in ignored and link.to_node.get(IDENTITY) not in ignored)
+    return hashlib.sha256(json.dumps([sorted(values), links], sort_keys=True).encode()).hexdigest()
+
+
+def tex_metadata(path):
+    from ..tex.file_re_tex import RE_TexFile
+    from ..tex.enums.tex_format_enum import texFormatToDXGIStringDict
+    tex = RE_TexFile()
+    tex.read(path)
+    header = tex.tex.header
+    return dict(format=texFormatToDXGIStringDict[header.format], width=header.width,
+                height=header.height, count=header.imageCount, mips=header.mipCount,
+                version=header.version, cube=header.cubemapMarker)
+
+
+def parameter_node_state(node):
+    def value(socket):
+        data = getattr(socket, "default_value", None)
+        if data is not None and not isinstance(data, (str, bool, float, int)):
+            data = list(data)
+        return data
+    return dict(inputs=[value(s) for s in node.inputs],
+                outputs=[value(s) for s in node.outputs] if node.type in {"VALUE", "RGB"} else [])
+
+
+def capture_materials(mesh_collection, mdf_collection):
+    mdf_materials = sorted((o for o in mdf_collection.all_objects if o.get("~TYPE") == "RE_MDF_MATERIAL"), key=lambda o: o.name)
+    materials = {slot.material for obj in mesh_collection.all_objects if obj.type == "MESH" for slot in obj.material_slots if slot.material}
+    result = []
+    for obj in mdf_materials:
+        props = obj.re_mdf_material
+        # Importer's Blender names may carry .001; original game names are retained here.
+        candidates = [m for m in materials if m.name == props.materialName or m.name.rsplit(".", 1)[0] == props.materialName]
+        if len(candidates) != 1:
+            continue
+        material = candidates[0]
+        entry = dict(id=identity(material), mdf_object=identity(obj), graph=graph_state(material, track_outputs=True), graph_version=2, slots=[])
+        if material.use_nodes:
+            entry["parameters"] = [dict(node=identity(material.node_tree.nodes[p.prop_name]), prop=p.prop_name,
+                state=parameter_node_state(material.node_tree.nodes[p.prop_name]))
+                for p in props.propertyList_items if p.prop_name in material.node_tree.nodes]
+            controlled = {p["node"] for p in entry["parameters"]}
+            entry["constant_nodes"] = [dict(node=identity(n), state=parameter_node_state(n))
+                for n in material.node_tree.nodes if n.type in {"VALUE", "RGB"} and identity(n) not in controlled]
+            for binding in props.textureBindingList_items:
+                node = material.node_tree.nodes.get(binding.textureType)
+                if node is None:
+                    continue
+                slot = dict(node=identity(node), type=binding.textureType, logical=binding.path,
+                            consumers=[(identity(link.to_node), link.to_socket.identifier, link.from_socket.identifier)
+                                       for link in material.node_tree.links if link.from_node == node])
+                if node.type == "TEX_IMAGE" and node.image:
+                    image = node.image
+                    source = image.get(SOURCE_TEX, "")
+                    slot.update(image=identity(image), state=image_state(image), source=source)
+                    if source and os.path.isfile(source):
+                        slot.update(relative=asset_relative(source), source_hash=file_hash(source), meta=tex_metadata(source))
+                        # Record both physical variants, never infer a low-resolution target from cache names.
+                        relative = slot["relative"]
+                        if "/streaming/" in relative.lower():
+                            parts = Path(source).parts
+                            companion = Path(*[p for p in parts if p.lower() != "streaming"])
+                            if companion.is_file():
+                                slot["companion"] = dict(source=str(companion), relative=asset_relative(companion), meta=tex_metadata(companion), source_hash=file_hash(companion))
+                elif node.type == "GROUP":
+                    slot["array_images"] = [dict(node=identity(n), image=identity(n.image), state=image_state(n.image))
+                        for n in material.node_tree.nodes if n.type == "TEX_IMAGE" and n.image and n.name.startswith("ARRAY_" + binding.textureType + "_")]
+                entry["slots"].append(slot)
+        result.append(entry)
+    return result
+
+
+def capture_baseline(collection, source, game, import_options=None, mdf_collection=None):
+    """Only called for newly imported data, never for an edited legacy collection."""
+    identity(collection)
+    version = int(Path(source).suffix[1:])
+    baseline = dict(schema=1, source=os.path.abspath(source), source_hash=file_hash(source),
+                    game=game, version=version, materials=[], import_options=import_options or {})
+    try:
+        baseline["relative"] = asset_relative(source)
+    except ValueError:
+        baseline["relative"] = ""
+    if mdf_collection:
+        baseline["mdf"] = identity(mdf_collection)
+        baseline["materials"] = capture_materials(collection, mdf_collection)
+    elif import_options and import_options.get("loadMaterials"):
+        baseline["error"] = "Material preview has no imported MDF data; bind the original source with MDF data enabled"
+    try:
+        baseline["fingerprint"], _ = snapshot(collection, game, version, baseline)
+    except Exception as error:
+        baseline["error"] = str(error)
+    collection[BASELINE] = json.dumps(baseline, ensure_ascii=False)
+    return baseline
+
+
+def load_baseline(collection, allow_mesh_validation_error=False, allow_mdf_validation_error=False):
+    if not collection.get(BASELINE):
+        raise ValueError(f"Untracked collection; bind original source and rebuild baseline: {collection.name}")
+    result = json.loads(collection[BASELINE])
+    if result.get("schema") != 1:
+        raise ValueError(f"Unsupported baseline: {collection.name}")
+    ignored_mesh_error = (allow_mesh_validation_error
+                          and collection.get("~TYPE") == "RE_MESH_COLLECTION"
+                          and str(result.get("error", "")).startswith("Mesh validation failed"))
+    ignored_mdf_error = (allow_mdf_validation_error
+                         and collection.get("~TYPE") == "RE_MDF_COLLECTION"
+                         and str(result.get("error", "")).startswith("MDF validation failed"))
+    if result.get("error") and not (ignored_mesh_error or ignored_mdf_error):
+        raise ValueError(f"Import baseline could not be built ({collection.name}): {result['error']}")
+    return result
+
+
+def expand_collections(collections):
+    result = {}
+    def visit(collection):
+        if collection.get("~TYPE") in SUPPORTED:
+            result[collection.as_pointer()] = collection
+        else:
+            for child in collection.children:
+                visit(child)
+    for collection in collections:
+        visit(collection)
+    for collection in list(result.values()):
+        if collection.get(BASELINE):
+            mdf_id = json.loads(collection[BASELINE]).get("mdf")
+            matches = [c for c in bpy.data.collections if mdf_id and c.get(IDENTITY) == mdf_id]
+            if len(matches) > 1:
+                raise ValueError("Duplicate asset identity; reimport copied collections separately")
+            for match in matches:
+                result[match.as_pointer()] = match
+    return list(result.values())
