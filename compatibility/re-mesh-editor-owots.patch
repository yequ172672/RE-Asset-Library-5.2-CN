index 0000000..134a951
--- /dev/null
+++ b/tests/blender_workspace_textures.py
@@ -0,0 +1,80 @@
+# Run inside Blender 5.2 with -- --output DIRECTORY
+import argparse
+_parser = argparse.ArgumentParser()
+_parser.add_argument('--output', required=True)
+_args = _parser.parse_args(__import__('sys').argv[__import__('sys').argv.index('--') + 1:])
+import sys, json, traceback, importlib, tempfile
+from pathlib import Path
+import bpy, addon_utils
+import numpy as np
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+addon_utils.enable('RE-Mesh-Editor-main', default_set=True)
+bpy.context.preferences.addons['RE-Mesh-Editor-main'].preferences.showConsole = False
+bpy.ops.wm.open_mainfile(filepath=str(Path(_args.output).resolve() / 'acceptance.blend'))
+t = importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_tracking')
+p = importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_pipeline')
+tx = importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_textures')
+pak_utils = importlib.import_module('RE-Asset-Library-cn.modules.pak.re_pak_utils')
+base = Path(str(Path(_args.output).resolve()))
+try:
+    mesh = next(c for c in bpy.data.collections if c.get('~TYPE') == 'RE_MESH_COLLECTION')
+    baseline = t.load_baseline(mesh)
+    mdf = next(c for c in bpy.data.collections if c.get(t.IDENTITY) == baseline['mdf'])
+    entry, slot = next((e, s) for e in baseline['materials'] for s in e['slots'] if s.get('meta') and s['meta']['count'] == 1 and 'BC7' in s['meta']['format'])
+    material = next(m for m in bpy.data.materials if m.get(t.IDENTITY) == entry['id'])
+    node = next(n for n in material.node_tree.nodes if n.get(t.IDENTITY) == slot['node'])
+    original = node.image
+    print('TEXTURE_TARGET', slot['relative'], slot['meta'], flush=True)
+    report = []
+    image = bpy.data.images.new('Replacement test', width=64, height=64, alpha=True)
+    image.colorspace_settings.name = original.colorspace_settings.name
+    pixels = np.tile(np.array([.15,.35,.65,.4], dtype=np.float32), 64*64)
+    image.pixels.foreach_set(pixels)
+    image.update()
+    for fmt, ext in [('PNG','.png'), ('JPEG','.jpg'), ('TARGA','.tga'), ('TIFF','.tiff')]:
+        source = base / ('replacement'+ext)
+        image.file_format = fmt
+        image.filepath_raw = str(source)
+        image.save()
+        replacement = bpy.data.images.load(str(source), check_existing=False)
+        replacement.colorspace_settings.name = original.colorspace_settings.name
+        replacement.alpha_mode = 'CHANNEL_PACKED'
+        node.image = replacement
+        plan = p.plan_export(bpy.context, [mdf], accept_alpha=True)
+        assert not plan.errors, plan.errors
+        assert plan.assets and all(a['kind'] == 'TEX' for a in plan.assets.values()), list(plan.assets)
+        result = p.execute_export(bpy.context, plan, make_pak=True)
+        plan.close()
+        assert result['total'] >= 2  # Previously exported mesh is retained.
+        output = base / 'modOutput/incremental' / slot['relative']
+        meta = t.tex_metadata(str(output))
+        assert (meta['width'],meta['height'],meta['mips']) == (64,64,7), meta
+        report.append({'input': ext, 'output': str(output), 'metadata': meta, 'result': result})
+        print('FORMAT_PASS', ext, meta, flush=True)
+        node.image = original
+        bpy.data.images.remove(replacement)
+    # Unsaved pixels, then packed image, must be read from Blender rather than disk.
+    node.image = image
+    image.pixels[0] = .9
+    image.update()
+    plan = p.plan_export(bpy.context, [mdf], accept_alpha=True)
+    assert not plan.errors, plan.errors
+    p.execute_export(bpy.context, plan)
+    plan.close()
+    image.pack()
+    plan = p.plan_export(bpy.context, [mdf], accept_alpha=True)
+    assert not plan.errors, plan.errors
+    p.execute_export(bpy.context, plan)
+    plan.close()
+    # Return to original: only selected MDF-owned textures disappear, mesh remains.
+    node.image = original
+    plan = p.plan_export(bpy.context, [mdf])
+    assert not plan.errors and not plan.assets, plan.errors
+    result = p.execute_export(bpy.context, plan, make_pak=True)
+    assert result['total'] == 1, result
+    plan.close()
+    (base/'texture-report.json').write_text(json.dumps(report, indent=2), encoding='utf-8')
+    print('TEXTURE_TEST_PASS', flush=True)
+except Exception:
+    traceback.print_exc()
+    sys.exit(1)
