@@ -0,0 +1,38 @@
+"""Blender regression: dialog open/options never trigger full asset planning."""
+import sys,importlib,time,tempfile
+from pathlib import Path
+from types import SimpleNamespace
+import bpy,addon_utils
+sys.path.insert(0,str(Path(__file__).resolve().parents[2]))
+addon_utils.enable('RE-Mesh-Editor-main',default_set=True)
+u=importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_operators')
+class Entries(list):
+ def add(self):
+  e=SimpleNamespace();self.append(e);return e
+checks=[]
+o=SimpleNamespace(entries=Entries(),_refresh=lambda context:checks.append(1),force_mesh=False,force_mdf=False,prefer_baseline_textures=False,
+ image_source='ERROR',accept_alpha=False,additional_source='',additional_path='',analyze_changes=False)
+context=SimpleNamespace(scene=bpy.context.scene,window_manager=SimpleNamespace(invoke_props_dialog=lambda *a,**kw:{'RUNNING_MODAL'}))
+old=u.selected_asset_collections
+u.selected_asset_collections=lambda context:[]
+try:
+ start=time.perf_counter();u.ExportWorkspaceMixin.invoke(o,context,None)
+ assert not checks,'Opening dialog ran full asset planning'
+ for i in range(20):
+  o.force_mesh=not o.force_mesh;o.prefer_baseline_textures=not o.prefer_baseline_textures;u.ExportWorkspaceMixin.check(o,context)
+ assert not checks,'Changing export options ran full asset planning'
+ elapsed=time.perf_counter()-start;assert elapsed<.1,elapsed
+ o.analyze_changes=True;u.ExportWorkspaceMixin.check(o,context)
+ assert len(checks)==1 and not o.analyze_changes
+ u.ExportWorkspaceMixin.check(o,context);assert len(checks)==1
+finally:u.selected_asset_collections=old
+# A subprocess crash becomes an ordinary export error in Blender.
+tx=importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_textures')
+old=tx.subprocess.run
+try:
+ tx.subprocess.run=lambda *a,**kw:SimpleNamespace(returncode=17,stderr=b'codec failed',stdout=b'')
+ with tempfile.TemporaryDirectory() as d:
+  try:tx.encode_dds(Path(d)/'input.png','BC7_UNORM',Path(d));raise AssertionError('Failure ignored')
+  except ValueError as e:assert 'codec failed' in str(e)
+finally:tx.subprocess.run=old
+print('DIALOG_LATENCY_PASS',elapsed,'ENCODER_FAILURE_CONTAINED',flush=True)
