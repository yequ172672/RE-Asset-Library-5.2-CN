+bpy.context.preferences.addons['RE-Mesh-Editor-main'].preferences.showConsole=False
+bpy.ops.wm.open_mainfile(filepath=args.blend)
+p=importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_pipeline')
+t=importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_tracking')
+mesh=next(c for c in bpy.data.collections if c.get('~TYPE')=='RE_MESH_COLLECTION')
+before=mesh[t.BASELINE];b=json.loads(before)
+mdf=next(c for c in bpy.data.collections if c.get(t.IDENTITY)==b['mdf'])
+source=Path(json.loads(mdf[t.BASELINE])['source'])
+parents=[c for c in [bpy.context.scene.collection,*bpy.context.scene.collection.children_recursive] if mdf.name in c.children]
+for o in list(mdf.objects):bpy.data.objects.remove(o,do_unlink=True)
+bpy.data.collections.remove(mdf)
+assert bpy.ops.re_mdf.importfile(filepath=str(source),directory=str(source.parent),files=[{'name':source.name}])=={'FINISHED'}
+new=next(c for c in bpy.data.collections if c.get('~TYPE')=='RE_MDF_COLLECTION')
+for parent in parents:
+ if new.name not in parent.children:parent.children.link(new)
+normal=p.plan_export(bpy.context,[mesh]);assert normal.errors;normal.close()
+forced=p.plan_export(bpy.context,[mesh],force_mdf=True)
+assert not forced.errors,forced.errors
+assert sum(a['kind']=='MDF' for a in forced.assets.values())==1
+assert mesh[t.BASELINE]==before
+bpy.context.scene['modWorkspace_directory']=str(Path(args.output).resolve())
+print('FORCE_MDF_RESULT',p.execute_export(bpy.context,forced));forced.close()
+# Missing original MDF fingerprint can be forced, but cannot mutate baseline.
+original=new[t.BASELINE];nb=json.loads(original);nb.pop('fingerprint',None);nb['error']='MDF validation failed: test';new[t.BASELINE]=json.dumps(nb)
+forced=p.plan_export(bpy.context,[mesh],force_mdf=True);assert not forced.errors,forced.errors;forced.close();new[t.BASELINE]=original
+# Ambiguous reimports must fail explicitly.
+copy=bpy.data.collections.new('Duplicate MDF');copy['~TYPE']='RE_MDF_COLLECTION';copy[t.BASELINE]=new[t.BASELINE]
+parents[0].children.link(copy)
+try:
+ p.plan_export(bpy.context,[mesh],force_mdf=True)
+ raise AssertionError('Ambiguous MDF silently accepted')
+except ValueError as e:assert 'uniquely associate' in str(e),e
+assert mesh[t.BASELINE]==before
+print('FORCE_MDF_PASS',flush=True)
