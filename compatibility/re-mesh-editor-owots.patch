+    @staticmethod
+    def _hasValidGDeflateHeaders(file, mipCount, imageCount):
+        """Distinguish Onimusha's uncompressed v251111100 from MHS3 GDeflate."""
+        count = mipCount * imageCount
+        headerPos = file.tell()
+        try:
+            file.seek(headerPos)
+            firstMipOffset = read_uint64(file)
+            file.seek(firstMipOffset)
+            compressedHeaders = [(read_uint(file), read_uint(file)) for _ in range(count)]
+            file.seek(0, 2)
