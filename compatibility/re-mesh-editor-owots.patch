+def getOWOTSMetadata(collection, objects):
+	"""Recover opaque fields from old scenes without replacing edited material data."""
+	flags = collection.get("re_mdf_header_flags")
+	values = {obj.name: obj.get("re_mdf_owots_value") for obj in objects}
+	if flags is None or any(value is None for value in values.values()):
+		baseline = json.loads(collection.get("re_export_baseline", "{}"))
+		sourcePath = collection.get("re_mdf_source_path") or baseline.get("source")
+		if not sourcePath or not os.path.isfile(sourcePath):
+			raise ValueError("OWOTS MDF metadata is missing. Reimport the original MDF before exporting.")
+		source = readMDF(sourcePath)
+		if not source.isOnimushaVariant:
+			raise ValueError("OWOTS MDF metadata source is not an Onimusha MDF.")
+		if flags is None:
+			flags = source.Header.materialFlags
+		byName = {}
+		for material in source.materialList:
+			byName.setdefault(material.materialName, []).append(material)
+		for obj in objects:
+			if values[obj.name] is None:
+				matches = byName.get(obj.re_mdf_material.materialName, [])
+				if len(matches) != 1:
+					raise ValueError(f"Cannot recover OWOTS metadata for {obj.name}; reimport the original MDF.")
+				values[obj.name] = matches[0].ver51UnknValue
+	return int(flags), {name: int(value) for name, value in values.items()}
