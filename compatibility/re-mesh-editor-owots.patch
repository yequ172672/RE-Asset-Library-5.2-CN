+"""Portable manifest and rollback-safe workspace publication (no Blender dependency)."""
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath
+import shutil
+import tempfile
+
+SCHEMA = 1
+
+
+def file_hash(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def safe_relative(value):
+    value = str(value).replace("\\", "/")
+    parts = value.split("/")
+    if not value or any(p in ("", ".", "..") for p in parts) or ":" in value or value.startswith("/"):
+        raise ValueError(f"Unsafe asset path: {value}")
+    return str(PurePosixPath(value))
+
+
+def inside(root, relative):
+    root = Path(root).resolve()
+    path = root.joinpath(*safe_relative(relative).split("/"))
+    if not path.resolve().is_relative_to(root):
+        raise ValueError(f"Asset path escapes workspace: {relative}")
+    return path
+
+
+def read_manifest(path):
+    if not Path(path).exists():
+        return {"schema": SCHEMA, "files": {}}
+    result = json.loads(Path(path).read_text(encoding="utf-8"))
+    if result.get("schema") != SCHEMA or not isinstance(result.get("files"), dict):
+        raise ValueError("Unsupported workspace export manifest")
+    seen = set()
+    for relative, entry in result["files"].items():
+        key = safe_relative(relative).casefold()
+        if key in seen or not isinstance(entry.get("owners"), list) or not isinstance(entry.get("sha256"), str):
+            raise ValueError(f"Invalid manifest entry: {relative}")
+        seen.add(key)
+    return result
+
+
+def reconcile(previous, selected, desired):
+    """Replace selected owners' outputs; retain other owners and detect shared conflicts."""
+    result = {}
+    old_by_key = {p.casefold(): (p, e) for p, e in previous["files"].items()}
+    for path, entry in previous["files"].items():
+        owners = sorted(set(entry["owners"]) - set(selected))
+        if owners:
+            result[path] = dict(entry, owners=owners)
+    for path, entry in desired.items():
+        path = safe_relative(path)
+        old_path, old = old_by_key.get(path.casefold(), (path, None))
+        retained = result.get(old_path)
+        if retained and retained["sha256"] != entry["sha256"]:
+            raise ValueError(f"Shared asset conflicts with another exported collection: {path}")
+        owners = set(entry["owners"]) | set((retained or {}).get("owners", []))
+        result[old_path] = dict(entry, owners=sorted(owners))
+    return {"schema": SCHEMA, "files": result}
+
+
+def publish(root, manifest_path, previous, current, staged, pak=None):
+    """Preflight every tracked file, then replace with rollback on any failure."""
+    root, manifest_path = Path(root), Path(manifest_path)
+    for relative, entry in previous["files"].items():
+        target = inside(root, relative)
+        if target.exists() and file_hash(target) != entry["sha256"]:
+            raise ValueError(f"Output was edited outside Blender: {relative}")
+    operations = []
+    for relative, entry in current["files"].items():
+        target = inside(root, relative)
+        source = staged.get(relative) or staged.get(relative.casefold())
+        if target.exists() and file_hash(target) == entry["sha256"]:
+            continue
+        if relative not in previous["files"] and target.exists():
+            raise ValueError(f"Unmanaged output already exists: {relative}")
+        if source is None or file_hash(source) != entry["sha256"]:
+            raise ValueError(f"Missing or invalid staged asset: {relative}")
+        operations.append((target, Path(source)))
+    for relative in previous["files"].keys() - current["files"].keys():
+        operations.append((inside(root, relative), None))
+    if pak:
+        operations.append((Path(pak[1]), Path(pak[0])))
+    manifest_path.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix=".publish-", dir=manifest_path.parent) as temp:
+        manifest_source = Path(temp) / "manifest.json"
+        manifest_source.write_text(json.dumps(current, indent=2, ensure_ascii=False), encoding="utf-8")
+        operations.append((manifest_path, manifest_source))
+        completed = []
+        try:
+            for index, (target, source) in enumerate(operations):
+                target.parent.mkdir(parents=True, exist_ok=True)
+                backup = Path(temp) / str(index)
+                existed = target.exists()
+                if existed:
+                    shutil.copy2(target, backup)
+                completed.append((target, backup if existed else None))
+                if source is None:
+                    target.unlink(missing_ok=True)
+                else:
+                    pending = target.with_name(target.name + ".re-export-pending")
+                    try:
+                        shutil.copy2(source, pending)
+                        os.replace(pending, target)
+                    finally:
+                        pending.unlink(missing_ok=True)
+        except BaseException:
+            for target, backup in reversed(completed):
+                if backup:
+                    shutil.copy2(backup, target)
+                else:
+                    target.unlink(missing_ok=True)
+            raise
