+"""Plan selected-collection changes and atomically publish a complete current Mod."""
+from dataclasses import dataclass, field
+import hashlib
+import importlib
+import json
+from pathlib import Path
+import shutil
+import sys
+import tempfile
+import copy
+
+import bpy
+
+from .export_manifest import file_hash, inside, publish, read_manifest, reconcile, safe_relative
+from .export_tracking import (BASELINE, IDENTITY, expand_collections, graph_state, identity,
+                              load_baseline, pixel_hash, snapshot, parameter_node_state)
+from .export_textures import convert_image, resolve_image
+
+
+@dataclass
+class ExportPlan:
+    selected: set = field(default_factory=set)
+    assets: dict = field(default_factory=dict)
+    errors: list = field(default_factory=list)
+    temporary_images: list = field(default_factory=list)
+    image_hashes: dict = field(default_factory=dict)
+    default_texture_paths: dict = field(default_factory=dict)
+
+    def is_game_default(self, logical, game):
+        if game not in self.default_texture_paths:
+            path = Path(__file__).parent / "texturepacker" / "tex_bindings_null.json"
+            mappings = json.loads(path.read_text(encoding="utf-8"))
+            self.default_texture_paths[game] = {
+                entry[game].replace("\\", "/").casefold()
+                for entry in mappings.values() if game in entry}
+        return logical.casefold() in self.default_texture_paths[game]
+
+    def image_hash(self, image):
+        key = image.as_pointer()
+        if key not in self.image_hashes:
+            self.image_hashes[key] = pixel_hash(image)
+        return self.image_hashes[key]
+
+    def close(self):
+        for image in self.temporary_images:
+            bpy.data.images.remove(image)
+        self.temporary_images.clear()
+
+
+def workspace(context):
+    scene = context.scene
+    if not scene.get("modWorkspace_setup"):
+        raise ValueError("Create a Mod Workspace first")
+    base = Path(bpy.path.abspath(scene["modWorkspace_directory"])).resolve()
+    name = safe_relative(scene["modWorkspace_internalName"])
+    if "/" in name:
+        raise ValueError("Invalid internal Mod name")
+    return base, base / "modOutput" / name, base / ".re-export-manifest.json", scene["modWorkspace_gameName"]
+
+
+def _add(plan, relative, asset):
+    relative = safe_relative(relative)
+    key = relative.casefold()
+    existing = plan.assets.get(key)
+    if existing:
+        if existing["fingerprint"] != asset["fingerprint"]:
+            raise ValueError(f"Conflicting replacement images/data for shared path: {relative}")
+        existing["owners"].update(asset["owners"])
+    else:
+        plan.assets[key] = dict(asset, relative=relative)
+
+
+def _find(data, identifier, label):
+    matches = [entry for entry in data if entry.get(IDENTITY) == identifier]
+    if len(matches) != 1:
+        raise ValueError(f"Missing or duplicated {label}; restore its import mapping")
+    return matches[0]
+
+
+def _textures(plan, baseline, owner, game, conflict, accept_alpha, prefer_baseline_textures=False):
+    mdf_id = baseline.get("mdf")
+    if not mdf_id:
+        return
+    mdf = _find(bpy.data.collections, mdf_id, "MDF collection")
+    for entry in baseline.get("materials", []):
+        material = _find(bpy.data.materials, entry["id"], "material")
+        obj = _find(mdf.all_objects, entry["mdf_object"], "MDF material")
+        input_overrides = {}
+        for parameter in entry.get("parameters", []):
+            node = _find(material.node_tree.nodes, parameter["node"], "MDF parameter node")
+            original_state = parameter["state"]
+            expected = copy.deepcopy(original_state)
+            prop = next((p for p in obj.re_mdf_material.propertyList_items if p.prop_name == parameter["prop"]), None)
+            if prop:
+                if prop.data_type in {"FLOAT", "BOOL"} and node.type == "VALUE":
+                    expected["outputs"][0] = prop.float_value if prop.data_type == "FLOAT" else float(prop.bool_value)
+                elif prop.data_type == "VEC4" and len(expected["inputs"]) >= 4:
+                    expected["inputs"][:4] = list(prop.float_vector_value)
+                elif prop.data_type == "COLOR" and "Color" in node.inputs:
+                    expected["inputs"][list(node.inputs).index(node.inputs["Color"])] = list(prop.color_value)
+            current = parameter_node_state(node)
+            if current != original_state and current != expected:
+                raise ValueError(f"Shader parameter differs from MDF; edit the MDF value: {material.name}/{parameter['prop']}")
+            input_overrides[parameter["node"]] = original_state["inputs"]
+        for constant in entry.get("constant_nodes", []):
+            node = _find(material.node_tree.nodes, constant["node"], "shader constant")
+            if parameter_node_state(node) != constant["state"]:
+                raise ValueError(f"Unsupported shader constant edit; use MDF parameters: {material.name}/{node.name}")
+        aliases, ignored, resolved = {}, set(), {}
+        for slot in entry["slots"]:
+            incoming = []
+            for target_id, socket_id, output_id in slot.get("consumers", []):
+                target = _find(material.node_tree.nodes, target_id, "texture consumer")
+                socket = next((s for s in target.inputs if s.identifier == socket_id), None)
+                links = list(socket.links) if socket else []
+                if len(links) != 1 or links[0].from_socket.identifier != output_id:
+                    raise ValueError(f"Unsupported texture reconnection: {material.name}/{slot['type']}")
+                incoming.append(links[0].from_node)
+            if incoming and all(n == incoming[0] for n in incoming) and incoming[0].type == "TEX_IMAGE":
+                node = incoming[0]
+                resolved[slot["node"]] = node
+                if identity(node) != slot["node"]:
+                    aliases[identity(node)] = slot["node"]
+                    ignored.add(slot["node"])
+        output_overrides = {p["node"]: p["state"]["outputs"] for p in entry.get("parameters", [])}
+        if graph_state(material, aliases, ignored, input_overrides=input_overrides,
+                       track_outputs=entry.get("graph_version", 1) >= 2, output_overrides=output_overrides) != entry["graph"]:
+            raise ValueError(f"Unsupported shader graph edit; bake into the original image slots: {material.name}")
+        for slot in entry["slots"]:
+            node = resolved.get(slot["node"])
+            if node is None:
+                node = _find(material.node_tree.nodes, slot["node"], "texture node")
+            bindings = [b for b in obj.re_mdf_material.textureBindingList_items if b.textureType == slot["type"]]
+            if not bindings:
+                continue  # Explicit MDF binding removal.
+            if len(bindings) != 1:
+                raise ValueError(f"Ambiguous MDF texture binding: {material.name}/{slot['type']}")
+            logical = bindings[0].path.replace("\\", "/").replace("@", "")
+            changed_path = logical != slot["logical"].replace("\\", "/").replace("@", "")
+            if node.type != "TEX_IMAGE":
+                for original in slot.get("array_images", []):
+                    array_node = _find(material.node_tree.nodes, original["node"], "array image node")
+                    if not array_node.image or array_node.image.get(IDENTITY) != original["image"] or pixel_hash(array_node.image) != original["state"]["pixels"]:
+                        raise ValueError(f"Array texture editing requires a complete texture set: {material.name}/{slot['type']}")
+                if changed_path:
+                    raise ValueError(f"Array texture editing requires a complete texture set: {material.name}/{slot['type']}")
+                continue
+            if not node.image:
+                raise ValueError(f"Texture slot has no image: {material.name}/{slot['type']}")
+            image, temporary = resolve_image(node.image, slot.get("state", {}), conflict, plan.image_hash(node.image))
+            if temporary:
+                plan.temporary_images.append(image)
+            current_hash = plan.image_hash(image)
+            changed = current_hash != slot.get("state", {}).get("pixels")
+            if not changed and not changed_path:
+                continue
+            if "meta" not in slot:
+                raise ValueError(f"Original TEX metadata missing: {material.name}/{slot['type']}")
+            source = Path(slot["source"])
+            if source.is_file() and file_hash(source) != slot["source_hash"]:
+                raise ValueError(f"Original TEX changed; reimport its baseline: {source}")
+            meta = slot["meta"]
+            relative = slot["relative"]
+            # Image replacement can target the imported asset without changing MDF bindings.
+            use_current_path = changed_path and not (prefer_baseline_textures and changed)
+            if use_current_path:
+                if not logical.lower().endswith(".tex"):
+                    raise ValueError(f"MDF binding must end in .tex without numeric version: {logical}")
+                prefix = relative.split("/")[:2]
+                relative = safe_relative("/".join(prefix) + "/" + logical + "." + str(meta["version"]))
+                # A reference-only edit to an existing game texture needs MDF only.
+                source_root = source
+                for _ in slot["relative"].split("/")[2:]:
+                    source_root = source_root.parent
+                if not changed and (plan.is_game_default(logical, game)
+                        or (source_root / (logical + "." + str(meta["version"]))).is_file()):
+                    continue
+            fingerprint = hashlib.sha256(("game-channels-v2:" + current_hash + json.dumps(meta, sort_keys=True)).encode()).hexdigest()
+            _add(plan, relative, dict(kind="TEX", image=image, meta=meta, fingerprint=fingerprint,
+                                     owners={owner}, accept_alpha=accept_alpha, size=None, force_pixels=conflict == "MEMORY"))
+            if not use_current_path and slot.get("companion"):
+                companion = slot["companion"]
+                if Path(companion["source"]).is_file() and file_hash(companion["source"]) != companion["source_hash"]:
+                    raise ValueError(f"Original base TEX changed: {companion['source']}")
+                cm = companion["meta"]
+                size = (min(image.size[0], cm["width"]), min(image.size[1], cm["height"]))
+                _add(plan, companion["relative"], dict(kind="TEX", image=image, meta=cm,
+                     fingerprint=hashlib.sha256((fingerprint + str(size)).encode()).hexdigest(),
+                     owners={owner}, accept_alpha=accept_alpha, size=size))
+
+
+def _recover_mdf_links(context, collections):
+    """Plan-only overrides; never rewrite imported fingerprints or scene IDs."""
+    overrides, replaced = {}, set()
+    scene_collections = list(context.scene.collection.children_recursive)
+    for mesh in list(collections):
+        if mesh.get("~TYPE") != "RE_MESH_COLLECTION" or not mesh.get(BASELINE):
+            continue
+        baseline = json.loads(mesh[BASELINE])
+        old_id = baseline.get("mdf")
+        if not old_id or any(c.get(IDENTITY) == old_id for c in bpy.data.collections):
+            continue
+        parents = [c for c in [context.scene.collection, *scene_collections] if mesh.name in c.children]
+        candidates = {}
+        mesh_path = baseline.get("relative", "").rsplit(".mesh.", 1)[0].casefold()
+        for parent in parents:
+            for c in parent.children:
+                if c.get("~TYPE") != "RE_MDF_COLLECTION" or not c.get(BASELINE):
+                    continue
+                record = json.loads(c[BASELINE])
+                if (record.get("game") == baseline.get("game") and mesh_path
+                        and record.get("relative", "").rsplit(".mdf2.", 1)[0].casefold() == mesh_path):
+                    candidates[c.as_pointer()] = c
+        if len(candidates) != 1:
+            raise ValueError(f"Cannot uniquely associate reimported MDF: {mesh.name}; keep one matching MDF under its model parent")
+        mdf = next(iter(candidates.values()))
+        baseline["mdf"] = identity(mdf)
+        for entry in baseline.get("materials", []):
+            material = _find(bpy.data.materials, entry["id"], "material")
+            matches = [o for o in mdf.all_objects if o.get("~TYPE") == "RE_MDF_MATERIAL"
+                       and (o.re_mdf_material.linkedMaterial == material
+                            or o.re_mdf_material.materialName in {material.name, material.name.rsplit(".", 1)[0]})]
+            if len(matches) != 1:
+                raise ValueError(f"Cannot match reimported MDF material: {material.name}")
+            entry["mdf_object"] = identity(matches[0])
+        overrides[identity(mesh)] = baseline
+        replaced.add(old_id)
+        if mdf not in collections:
+            collections.append(mdf)
+    return overrides, replaced
+
+
+def _plan_export(context, collections, conflict="ERROR", accept_alpha=False, additional=(), force_mesh=False, force_mdf=False, prefer_baseline_textures=False):
+    plan = ExportPlan()
+    if context.scene.get("re_export_save_error"):
+        plan.errors.append("Edited image buffers could not be saved: " + context.scene["re_export_save_error"])
+    _, _, _, game = workspace(context)
+    collections = expand_collections(collections)
+    overrides, replaced = _recover_mdf_links(context, collections) if force_mdf else ({}, set())
+    if not collections and not additional:
+        plan.errors.append("No imported asset collections were found")
+        return plan
+    ids = [identity(c) for c in collections]
+    if len(set(ids)) != len(ids):
+        plan.errors.append("Duplicate collection identities; reimport copied assets separately")
+        return plan
+    plan.selected.update(ids)
+    plan.selected.update(replaced)
+    snapshots = {}
+    for collection in collections:
+        try:
+            forced_mesh = force_mesh and collection.get("~TYPE") == "RE_MESH_COLLECTION"
+            forced_mdf = force_mdf and collection.get("~TYPE") == "RE_MDF_COLLECTION"
+            baseline = load_baseline(collection, allow_mesh_validation_error=forced_mesh, allow_mdf_validation_error=forced_mdf)
+            baseline = overrides.get(identity(collection), baseline)
+            if baseline["game"] != game:
+                raise ValueError(f"Game mismatch: {collection.name} ({baseline['game']} / {game})")
+            if not baseline["relative"]:
+                raise ValueError(f"Bind a natives/platform source path: {collection.name}")
+            if Path(baseline["source"]).is_file() and file_hash(baseline["source"]) != baseline["source_hash"]:
+                raise ValueError(f"Original source changed; rebuild baseline: {collection.name}")
+            details = {}
+            fingerprint, payload = snapshot(collection, game, baseline["version"], details)
+            snapshots[identity(collection)] = details
+            if forced_mesh or forced_mdf or fingerprint != baseline["fingerprint"]:
+                _add(plan, baseline["relative"], dict(kind="MESH" if collection.get("~TYPE") == "RE_MESH_COLLECTION" else "MDF",
+                     payload=payload, fingerprint=fingerprint, owners={identity(collection)}))
+            if collection.get("~TYPE") == "RE_MESH_COLLECTION":
+                _textures(plan, baseline, baseline.get("mdf", identity(collection)), game, conflict, accept_alpha, prefer_baseline_textures)
+        except Exception as error:
+            plan.errors.append(f"{collection.name}: {error}")
+    for collection in collections:
+        if collection.get("~TYPE") != "RE_MESH_COLLECTION" or not collection.get(BASELINE):
+            continue
+        baseline = overrides.get(identity(collection), json.loads(collection[BASELINE]))
+        mesh_names = snapshots.get(identity(collection), {}).get("material_names")
+        mdf_names = snapshots.get(baseline.get("mdf"), {}).get("material_names")
+        if mesh_names is not None and mdf_names is not None and (len(mesh_names) != len(mdf_names) or set(mesh_names) != set(mdf_names)):
+            plan.errors.append(f"Mesh/MDF material names or counts differ: {collection.name}")
+    # An explicitly selected MDF can be exported with its associated texture edits.
+    for collection in bpy.data.collections:
+        if collection in collections or not collection.get(BASELINE):
+            continue
+        baseline = json.loads(collection[BASELINE])
+        if baseline.get("mdf") in plan.selected:
+            try:
+                _textures(plan, baseline, baseline["mdf"], game, conflict, accept_alpha, prefer_baseline_textures)
+            except Exception as error:
+                plan.errors.append(str(error))
+    for source, relative in additional:
+        try:
+            if not safe_relative(relative).lower().startswith("natives/"):
+                raise ValueError("Additional game assets must be inside natives")
+            owner = "additional:" + relative.casefold()
+            plan.selected.add(owner)
+            _add(plan, relative, dict(kind="FILE", source=source, fingerprint=file_hash(source), owners={owner}))
+        except Exception as error:
+            plan.errors.append(str(error))
+    return plan
+
+
+def plan_export(context, collections, conflict="ERROR", accept_alpha=False, additional=(), force_mesh=False, force_mdf=False, prefer_baseline_textures=False):
+    context.window_manager.progress_begin(0, 1)
+    try:
+        return _plan_export(context, collections, conflict, accept_alpha, additional, force_mesh, force_mdf, prefer_baseline_textures)
+    finally:
+        context.window_manager.progress_end()
+
+
+def _pak_builder():
+    for name in list(sys.modules):
+        if name.endswith(".modules.pak.re_pak_utils"):
+            return sys.modules[name].createPakPatch
+    for name in bpy.context.preferences.addons.keys():
+        if "asset" in name.lower() and "library" in name.lower():
+            return importlib.import_module(name + ".modules.pak.re_pak_utils").createPakPatch
+    raise ValueError("Enable RE Asset Library to export Mod PAK")
+
+
+def execute_export(context, plan, make_pak=False):
+    if context.window_manager.enableModFileTracking:
+        raise ValueError("Turn off Mod File Tracking before exporting; automatic game deployment is active")
+    if plan.errors:
+        raise ValueError("\n".join(plan.errors))
+    base, root, manifest_path, game = workspace(context)
+    previous = read_manifest(manifest_path)
+    builder = _pak_builder() if make_pak else None
+    base.mkdir(parents=True, exist_ok=True)
+    wm = context.window_manager
+    wm.progress_begin(0, len(plan.assets) + 2)
+    try:
+        with tempfile.TemporaryDirectory(prefix=".re-export-", dir=base) as temp:
+            temp = Path(temp)
+            staged, desired = {}, {}
+            old_index = {p.casefold(): (p, e) for p, e in previous["files"].items()}
+            for index, (key, asset) in enumerate(plan.assets.items()):
+                wm.progress_update(index)
+                relative = asset["relative"]
+                old_path, old = old_index.get(key, (relative, {}))
+                existing = inside(root, old_path)
+                if old.get("fingerprint") == asset["fingerprint"] and existing.is_file() and file_hash(existing) == old["sha256"]:
+                    staged[old_path] = existing
+                    digest = old["sha256"]
+                else:
+                    destination = inside(temp / "assets", relative)
+                    destination.parent.mkdir(parents=True, exist_ok=True)
+                    if asset["kind"] == "TEX":
+                        convert_image(asset["image"], destination, asset["meta"], game,
+                                      asset["accept_alpha"], asset["size"], asset.get("force_pixels", False))
+                    elif asset["kind"] == "FILE":
+                        shutil.copy2(asset["source"], destination)
+                    else:
+                        destination.write_bytes(asset["payload"])
+                    digest = file_hash(destination)
+                    staged[old_path] = destination
+                desired[old_path] = dict(sha256=digest, fingerprint=asset["fingerprint"], owners=sorted(asset["owners"]), kind=asset["kind"])
+            current = reconcile(previous, plan.selected, desired)
+            pak = None
+            if make_pak:
+                if not current["files"]:
+                    raise ValueError("No changed assets; an empty Mod PAK was not created")
+                pack_root = temp / "package"
+                for relative, entry in current["files"].items():
+                    source = staged.get(relative, inside(root, relative))
+                    if not Path(source).is_file() or file_hash(source) != entry["sha256"]:
+                        raise ValueError(f"Missing or externally edited output: {relative}")
+                    destination = inside(pack_root, relative)
+                    destination.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(source, destination)
+                wm.progress_update(len(plan.assets))
+                output = temp / "mod.pak"
+                builder(str(pack_root), str(output))
+                if not output.is_file() or output.stat().st_size <= 16:
+                    raise ValueError("PAK builder did not produce a valid output")
+                pak_module = importlib.import_module(builder.__module__)
+                lookup = pak_module.getPakLookupTable(str(output))
+                expected = {pak_module.pathToPakHash(path) for path in current["files"]}
+                expected.add(pak_module.pathToPakHash("__MANIFEST/MANIFEST.TXT"))
+                if set(lookup) != expected:
+                    raise ValueError("PAK contents do not match the export manifest")
+                with output.open("rb") as stream:
+                    for relative, entry in current["files"].items():
+                        payload = pak_module.readPakEntryData(lookup[pak_module.pathToPakHash(relative)], stream)
+                        if hashlib.sha256(payload).hexdigest() != entry["sha256"]:
+                            raise ValueError(f"PAK payload verification failed: {relative}")
+                pak = (output, base / "modOutput" / (root.name + ".pak"))
+            publish(root, manifest_path, previous, current, staged, pak)
+            if pak:
+                context.scene["lastExportedPatchPak"] = str(pak[1])
+            wm.progress_update(len(plan.assets) + 2)
+            return dict(changed=len(desired), total=len(current["files"]), path=str(pak[1] if pak else root))
+    finally:
+        wm.progress_end()
