+"""Keep edited tracked image buffers alive across .blend saves."""
+import json
+import bpy
+from bpy.app.handlers import persistent
+from .export_tracking import BASELINE, IDENTITY, pixel_hash
+
+
+@persistent
+def persist_edited_images(_unused=None):
+    material_ids = set()
+    original_pixels = {}
+    for collection in bpy.data.collections:
+        if collection.get(BASELINE):
+            baseline = json.loads(collection[BASELINE])
+            for material in baseline.get("materials", []):
+                material_ids.add(material["id"])
+                for slot in material["slots"]:
+                    if slot.get("image") and slot.get("state"):
+                        original_pixels[slot["image"]] = slot["state"]["pixels"]
+    visited = set()
+    errors = []
+    for material in bpy.data.materials:
+        if material.get(IDENTITY) not in material_ids or not material.use_nodes:
+            continue
+        for node in material.node_tree.nodes:
+            if node.type != "TEX_IMAGE" or not node.image:
+                continue
+            image = node.image
+            key = image.as_pointer()
+            if key in visited or not image.is_dirty:
+                continue
+            visited.add(key)
+            try:
+                if pixel_hash(image) != original_pixels.get(image.get(IDENTITY)):
+                    image.pack()
+            except Exception as error:
+                errors.append(f"{image.name}: {error}")
+    for scene in bpy.data.scenes:
+        if errors:
+            scene["re_export_save_error"] = "\n".join(errors)
+        elif "re_export_save_error" in scene:
+            del scene["re_export_save_error"]
+
+
+def register():
+    if persist_edited_images not in bpy.app.handlers.save_pre:
+        bpy.app.handlers.save_pre.append(persist_edited_images)
+
+
+def unregister():
+    if persist_edited_images in bpy.app.handlers.save_pre:
+        bpy.app.handlers.save_pre.remove(persist_edited_images)
