--- /dev/null
+++ b/tests/blender_baseline_texture_paths.py
@@ -0,0 +1,36 @@
+"""Run in a scene with an edited NRRO image and its MDF redirected to a game default."""
+import importlib
+import json
+import bpy
+
+
+def verify(p):
+    c = bpy.data.collections['ch001_00_00.mesh']
+    baseline_text = c['re_export_baseline']
+    baseline = json.loads(baseline_text)
+    slot = next(s for material in baseline['materials'] for s in material['slots']
+                if s['type'] == 'NormalRoughnessOcclusionMap'
+                and 'Cloth_Top_Mat_NRRO' in s['logical'])
+    mdf = next(c for c in bpy.data.collections if c.get('re_export_id') == baseline['mdf'])
+    before = [(o.name, [(b.textureType, b.path) for b in o.re_mdf_material.textureBindingList_items]) for o in mdf.all_objects]
+    targets = {}
+    for enabled in (False, True):
+        plan = p.ExportPlan()
+        try:
+            p._textures(plan, baseline, baseline['mdf'], 'OWOTS', 'ERROR', False, enabled)
+            targets[enabled] = {a['relative'] for a in plan.assets.values()}
+            if enabled:
+                assert slot['relative'] in targets[enabled], targets[enabled]
+                if slot.get('companion'):
+                    assert slot['companion']['relative'] in targets[enabled]
+                assert not any('null_nrro' in x.lower() for x in targets[enabled])
+            else:
+                assert any('null_nrro' in x.lower() for x in targets[enabled]), targets[enabled]
+        finally:
+            plan.close()
+    assert c['re_export_baseline'] == baseline_text
+    assert before == [(o.name, [(b.textureType, b.path) for b in o.re_mdf_material.textureBindingList_items]) for o in mdf.all_objects]
+    print('BASELINE_TEXTURE_PATH_PASS', json.dumps({str(k): sorted(v) for k, v in targets.items()}))
+
+if __name__ == '__main__':
+    verify(importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_pipeline'))
