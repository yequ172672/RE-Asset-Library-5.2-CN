@@ -0,0 +1,47 @@
+"""Blender regression: -- --source <OWOTS mesh with unsupported export weights>."""
+import argparse
+import importlib
+import json
+from pathlib import Path
+import sys
+
+import bpy
+import addon_utils
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--source', required=True)
+args = parser.parse_args(sys.argv[sys.argv.index('--') + 1:])
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+addon_utils.enable('RE-Mesh-Editor-main', default_set=True)
+bpy.context.preferences.addons['RE-Mesh-Editor-main'].preferences.showConsole = False
+mesh = importlib.import_module('RE-Mesh-Editor-main.modules.mesh.blender_re_mesh')
+tracking = importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_tracking')
+popups = []
+original_window = mesh.showREMeshErrorWindow
+mesh.showREMeshErrorWindow = lambda *values: popups.append(values)
+try:
+    source = Path(args.source).resolve()
+    result = bpy.ops.re_mesh.importfile(filepath=str(source), directory=str(source.parent),
+        files=[{'name': source.name}], clearScene=False, loadMaterials=False,
+        loadMDFData=False, createCollections=True)
+    assert result == {'FINISHED'}
+    assert not popups, 'Import opened an export error window'
+    collection = next(c for c in bpy.data.collections if c.get('~TYPE') == 'RE_MESH_COLLECTION')
+    baseline = json.loads(collection[tracking.BASELINE])
+    assert 'MaxWeightsPerVertexExceeded' in baseline['error'], baseline
+    assert 'fingerprint' not in baseline, 'Invalid mesh must not acquire a valid baseline'
+    assert not bpy.data.collections.get('clonedMeshes')
+    assert not any(o.name.startswith('CLN_') for o in bpy.data.objects)
+    def weights():
+        return {o.name: [[(g.group, g.weight) for g in v.groups] for v in o.data.vertices]
+                for o in collection.all_objects if o.type == 'MESH'}
+    before = weights()
+    # Manual export must still report validation errors and leave weights intact.
+    with tracking.export_context('OWOTS'):
+        result = mesh.exportREMeshFile(str(source.parent / 'never-written.mesh.260209350'),
+                                      tracking.mesh_options(collection))
+    assert result is False and len(popups) == 1
+    assert weights() == before, 'Validation changed original weights'
+    print('IMPORT_POPUP_REGRESSION_PASS', flush=True)
+finally:
+    mesh.showREMeshErrorWindow = original_window
