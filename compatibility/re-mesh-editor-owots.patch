+    assert len(v.groups)==1 and v.groups[0].weight==1
+    assert o.vertex_groups[v.groups[0].group].name in arm.data.bones
+ t=importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_tracking')
+ import json
+ baseline=json.loads(c[t.BASELINE]);fingerprint,payload=t.snapshot(c,baseline['game'],baseline['version'])
+ assert payload
