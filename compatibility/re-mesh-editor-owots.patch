+def _build_catalog():
+    catalog = {}
+    for message_table in (_UI_MESSAGES, _EXTRA_UI_MESSAGES):
+        catalog.update({("*", message): translation for message, translation in message_table.items()})
+        catalog.update({("Operator", message): translation for message, translation in message_table.items()})
+    for message, translation in _OPERATOR_MESSAGES.items():
+        catalog[("*", message)] = translation
+        catalog[("Operator", message)] = translation
+    return catalog
+
+
+translations_dict = {
+    "zh_HANS": _build_catalog(),
+    "zh_CN": _build_catalog(),
+}
+
+
+def pgettext_iface(message, msgctxt="*"):
+    """Translate an interface string while preserving the English fallback."""
+
+    return bpy.app.translations.pgettext_iface(message, msgctxt)
+
+
+def pgettext_tip(message, msgctxt="Operator"):
+    """Translate an operator tooltip/report while preserving the English fallback."""
+
+    return bpy.app.translations.pgettext_tip(message, msgctxt)
+
+
+def ifacef(message, **values):
+    """Translate and format a dynamic interface message."""
+
+    return pgettext_iface(message).format(**values)
+
+
+def tipf(message, **values):
+    """Translate and format a dynamic operator message."""
+
+    return pgettext_tip(message).format(**values)
+
+
+def register():
+    """Register this add-on's translations without changing global preferences."""
+
+    global _REGISTERED
+    if _REGISTERED:
+        return
+    try:
+        bpy.app.translations.unregister(_TRANSLATION_MODULE_NAME)
+    except (KeyError, RuntimeError, ValueError):
+        pass
+    bpy.app.translations.register(_TRANSLATION_MODULE_NAME, translations_dict)
+    _REGISTERED = True
+
+
+def unregister():
+    """Unregister this add-on's translation table."""
+
+    global _REGISTERED
+    try:
+        bpy.app.translations.unregister(_TRANSLATION_MODULE_NAME)
+    except (KeyError, RuntimeError, ValueError):
+        pass
+    _REGISTERED = False
+
+
+__all__ = [
+    "translations_dict",
+    "pgettext_iface",
+    "pgettext_tip",
+    "ifacef",
+    "tipf",
+    "register",
+    "unregister",
+]
