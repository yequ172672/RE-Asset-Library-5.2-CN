+class WM_OT_ConvertToEmptyMesh(Operator):
+    bl_label = "Convert to Empty Mesh"
+    bl_idname = "re_mesh.convert_to_empty_mesh"
+    bl_description = "Replace selected meshes with tiny four-vertex placeholders while preserving materials and armature links"
+    bl_options = {'REGISTER', 'UNDO'}
+
+    plane_size: FloatProperty(name="Placeholder Size", default=0.0001, min=0.00001, max=0.001,
+        description="Side length of the placeholder plane in local coordinates")
+
+    @classmethod
+    def poll(cls, context):
+        return context.mode == 'OBJECT' and any(o.type == 'MESH' and o.is_editable for o in context.selected_objects)
+
+    def execute(self, context):
+        targets = [o for o in context.selected_objects if o.type == 'MESH' and o.is_editable]
+        if not targets:
+            return {'CANCELLED'}
+        # Validate every skinned object before replacing any geometry.
+        groups = {}
+        for obj in targets:
+            armature = obj.find_armature()
+            if armature:
+                valid = [g.name for g in obj.vertex_groups if g.name in armature.data.bones]
+                if not valid:
+                    valid = [b.name for b in armature.data.bones if b.use_deform]
+                if not valid:
+                    self.report({'ERROR'}, translations.tipf("No deform bone available for {name}", name=obj.name))
+                    return {'CANCELLED'}
+                groups[obj.name] = valid[0]
+        half = self.plane_size / 2
+        for obj in targets:
+            old = obj.data
+            mesh = bpy.data.meshes.new(old.name + "_placeholder")
+            mesh.from_pydata([(-half, -half, 0), (half, -half, 0), (half, half, 0), (-half, half, 0)], [], [(0, 1, 2, 3)])
+            for material in old.materials:
+                mesh.materials.append(material)
+            mesh.polygons[0].material_index = old.polygons[0].material_index if old.polygons else obj.active_material_index
+            uv = mesh.uv_layers.new(name=old.uv_layers.active.name if old.uv_layers.active else "UVMap")
+            for item, value in zip(uv.data, [(0, 0), (1, 0), (1, 1), (0, 1)]):
+                item.uv = value
+            for key in old.keys():
+                mesh[key] = old[key]
+            obj.data = mesh
+            if obj.name in groups:
+                group = obj.vertex_groups.get(groups[obj.name]) or obj.vertex_groups.new(name=groups[obj.name])
+                group.add([0, 1, 2, 3], 1.0, 'REPLACE')
+            mesh.update()
+        self.report({'INFO'}, translations.tipf("Converted {count} meshes to placeholders", count=len(targets)))
+        return {'FINISHED'}
