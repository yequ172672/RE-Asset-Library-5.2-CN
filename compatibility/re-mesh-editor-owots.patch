index 0000000..5e23842
--- /dev/null
+++ b/tests/test_export_manifest.py
@@ -0,0 +1,58 @@
+"""Run with ordinary Python: python -m unittest discover -s tests."""
+import importlib.util
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+spec = importlib.util.spec_from_file_location("export_manifest", Path(__file__).parents[1] / "modules/workspace/export_manifest.py")
+m = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(m)
+
+
+class ManifestTests(unittest.TestCase):
+    def test_paths_reject_escape_and_windows_drives(self):
+        for path in ("../x", "natives/../../x", "C:/x", "/x", "natives//x", "natives/./x"):
+            with self.subTest(path=path), self.assertRaises(ValueError):
+                m.safe_relative(path)
+        self.assertEqual(m.safe_relative(r"natives\stm\x.tex.1"), "natives/stm/x.tex.1")
+
+    def test_partial_export_retains_other_owners_and_revert_removes_selected(self):
+        old = {"files": {"natives/stm/a": {"sha256": "a", "owners": ["A"]}, "natives/stm/b": {"sha256": "b", "owners": ["B"]}}}
+        current = m.reconcile(old, {"A"}, {})
+        self.assertEqual(set(current["files"]), {"natives/stm/b"})
+
+    def test_shared_conflict_case_insensitive(self):
+        old = {"files": {"natives/stm/a": {"sha256": "a", "owners": ["A", "B"]}}}
+        with self.assertRaisesRegex(ValueError, "Shared asset"):
+            m.reconcile(old, {"A"}, {"natives/STM/A": {"sha256": "b", "owners": ["A"]}})
+
+    def test_publish_rollback_and_external_edit_protection(self):
+        with tempfile.TemporaryDirectory() as directory:
+            base = Path(directory)
+            root, manifest = base / "output", base / "manifest.json"
+            source = base / "stage"
+            source.write_bytes(b"first")
+            relative = "natives/stm/a.tex.1"
+            previous = {"schema": 1, "files": {}}
+            current = {"schema": 1, "files": {relative: {"sha256": m.file_hash(source), "owners": ["A"]}}}
+            m.publish(root, manifest, previous, current, {relative: source})
+            self.assertEqual(m.inside(root, relative).read_bytes(), b"first")
+            source.write_bytes(b"second")
+            second = {"schema": 1, "files": {relative: {"sha256": m.file_hash(source), "owners": ["A"]}}}
+            real_replace = m.os.replace
+            def fail_manifest(src, dst):
+                if Path(dst) == manifest:
+                    raise OSError("injected manifest failure")
+                return real_replace(src, dst)
+            with patch.object(m.os, "replace", side_effect=fail_manifest), self.assertRaises(OSError):
+                m.publish(root, manifest, current, second, {relative: source})
+            self.assertEqual(m.inside(root, relative).read_bytes(), b"first")
+            self.assertEqual(m.read_manifest(manifest), current)
+            m.inside(root, relative).write_bytes(b"manual")
+            with self.assertRaisesRegex(ValueError, "outside Blender"):
+                m.publish(root, manifest, current, second, {relative: source})
+
+
+if __name__ == "__main__":
+    unittest.main()
