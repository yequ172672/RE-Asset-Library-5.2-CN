@@ -0,0 +1,33 @@
+"""Blender: -- --blend <three-collection reproduction> --output <isolated workspace>."""
+import argparse,sys,importlib,time
+from pathlib import Path
+import bpy,addon_utils
+args=argparse.ArgumentParser();args.add_argument('--blend',required=True);args.add_argument('--output',required=True)
+args.add_argument('--expected-textures',type=int)
+a=args.parse_args(sys.argv[sys.argv.index('--')+1:])
+sys.path.insert(0,str(Path(__file__).resolve().parents[2]))
+addon_utils.enable('RE-Mesh-Editor-main',default_set=True)
+bpy.context.preferences.addons['RE-Mesh-Editor-main'].preferences.showConsole=False
+bpy.ops.wm.open_mainfile(filepath=a.blend)
+p=importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_pipeline')
+t=importlib.import_module('RE-Mesh-Editor-main.modules.workspace.export_tracking')
+collections=[c for c in bpy.context.scene.collection.children_recursive if c.get('~TYPE')=='RE_MESH_COLLECTION']
+bpy.context.scene['modWorkspace_directory']=str(Path(a.output).resolve())
+start=time.perf_counter()
+plan=p.plan_export(bpy.context,collections,force_mesh=True,force_mdf=True)
+try:
+ assert not plan.errors,plan.errors
+ if a.expected_textures is not None:
+  assert sum(asset['kind']=='TEX' for asset in plan.assets.values())==a.expected_textures
+ result=p.execute_export(bpy.context,plan)
+ root=p.workspace(bpy.context)[1]
+ mesh_reader=importlib.import_module('RE-Mesh-Editor-main.modules.mesh.file_re_mesh').readREMesh
+ mdf_reader=importlib.import_module('RE-Mesh-Editor-main.modules.mdf.file_re_mdf').readMDF
+ for asset in plan.assets.values():
+  path=root/asset['relative'];assert path.is_file()
+  if asset['kind']=='MESH':assert mesh_reader(str(path)) is not None
+  if asset['kind']=='MDF':assert mdf_reader(str(path)) is not None
+  if asset['kind']=='TEX':
+   meta=t.tex_metadata(str(path));assert meta['mips']==max(meta['width'],meta['height']).bit_length()
+ print('EXPORT_CRASH_REGRESSION_PASS',time.perf_counter()-start,result,flush=True)
+finally:plan.close()
